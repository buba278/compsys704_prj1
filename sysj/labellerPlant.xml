<System xmlns="http://systemjtechnology.com">
      <SubSystem Name="SS2" Local="true">
              <ClockDomain Name="LabellerPlantCD" Class="LabellerPlant">
                      <!-- Inputs from Controller -->
                      <iSignal Name="printLabel"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="clampBottle"      Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="applyLabel"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="bottleFromConveyor" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="bottleDefectiveFromConveyor" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="sorterTakenAck"     Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="liquidARatio"     Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="targetVolumeMl"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />
                      <iSignal Name="productIdSig" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10009" />

                      <!-- Outputs to Controller -->
                      <oSignal Name="bottleAtLabeller" To="LabellerControllerCD.bottleAtLabeller" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10008" />
                      <oSignal Name="labelPrinted"     To="LabellerControllerCD.labelPrinted"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10008" />
                      <oSignal Name="bottleClamped"    To="LabellerControllerCD.bottleClamped"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10008" />
                      <oSignal Name="labelApplied"     To="LabellerControllerCD.labelApplied"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10008" />
              			
              		<oSignal Name="bottleAtLabellerE" To="UI.bottleAtLabellerE" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />
              		<oSignal Name="bottleGoneE"       To="UI.bottleGoneE"       Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />
					<oSignal Name="labelPrintedE"     To="UI.labelPrintedE"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />
					<oSignal Name="bottleClampedE"    To="UI.bottleClampedE"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />
					<oSignal Name="labelAppliedE"     To="UI.labelAppliedE"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />
					<oSignal Name="liquidARatioE"     To="UI.liquidARatioE"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />
					<oSignal Name="targetVolumeMlE"   To="UI.targetVolumeMlE"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />
					<oSignal Name="productIdE" To="UI.productIdE" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10020" />

					<oSignal Name="bottleAtLabellerBigE" To="BigPicture.bottleAtLabellerBigE" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20008" />
					<oSignal Name="labelPrintedBigE"     To="BigPicture.labelPrintedBigE"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20008" />
					<oSignal Name="bottleClampedBigE"    To="BigPicture.bottleClampedBigE"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20008" />
					<oSignal Name="labelAppliedBigE"     To="BigPicture.labelAppliedBigE"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20008" />
					<oSignal Name="liquidARatioBigE"     To="BigPicture.liquidARatioBigE"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20008" />
					<oSignal Name="targetVolumeMlBigE"   To="BigPicture.targetVolumeMlBigE"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20008" />
              
              </ClockDomain>
      </SubSystem>
</System>