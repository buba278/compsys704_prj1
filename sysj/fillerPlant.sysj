import run.FillerGUI;
import run.FillerFaultState;

FillerPlant(
		input signal valve1Open, valve2Open;					// fillerController -> fillerPlant
		input Integer signal doseTargetMl;						// fillerController -> fillerPlant
		input signal bottleAtPos2;								// turntable -> fillerPlant (allowed?)
		input signal overfillM;									// GUI -> fillerPlant (manual fault injection: overfill this bottle)
		output signal levelAtTarget;							// fillerPlant -> fillerController
		output signal valve1OpenE, valve2OpenE;					// fillerPlant -> fillerGUI
		output Integer signal fillLevelE;						// fillerPlant -> fillerGUI
		output Integer signal fillLevelMl;						// fillerPlant -> fillerController (reported level, for fault detection)
)
->
{
	new Thread(new FillerGUI()).start();

	int signal fillLevel;
	emit fillLevel(0);
	int signal doseTarget;
	emit doseTarget(0);
	signal levelAtTargetPulse;   // local: hands the one-tick crossing edge to the widening thread below

	{
		loop {
			present (doseTargetMl) {
				emit doseTarget((Integer)#doseTargetMl);
			}
			present(!bottleAtPos2) {
				emit fillLevel(0);
				emit fillLevelE(0);
				emit fillLevelMl(0);
				FillerFaultState.clearOverfill(); // reset the manual override so it doesn't bleed into the next bottle
			} else {
			present (valve1Open || valve2Open) {
				// simplified indication of flow over time - might need to make slower
				int prevLvl = (Integer)#fillLevel;
				int target = (Integer)#doseTarget;
				int stopAt = FillerFaultState.isOverfillArmed() ?
						target + 8 :   // manual override: run this far past target before "reaching target"
						target;
				int lvl = Math.min(prevLvl + 1, stopAt);
				emit fillLevel(lvl);
				emit fillLevelE(lvl);
				emit fillLevelMl(lvl);
				System.out.printf("lvl=%d doseTarget=%d%n", lvl, target);
				if (prevLvl < stopAt && lvl >= stopAt) {
					System.out.printf("target reached at lvl=%d (nominal target=%d)%n", lvl, target);
					emit levelAtTargetPulse;
				}
			}
			}
			pause;
		}
	}
	||
	{
		// Latches the manual overfill trigger (a momentary button-press pulse) into the
		// Java-side flag for the rest of this bottle's fill; cleared above once the
		// bottle leaves.
		loop {
			present (overfillM) {
				FillerFaultState.armOverfill();
			}
			pause;
		}
	}
	||
	{
		loop {
            present (valve1Open) { 
            	emit valve1OpenE; 
            }
            present (valve2Open) {
            	emit valve2OpenE;
            }
            pause;
		}
	}
	||
	{
		// Widen the single-tick "at target" edge into a reliably-delivered hold.
		// Bounded by the NEXT doseTargetMl (start of the following phase/bottle) rather
		// than a fixed timer, so it cannot bleed stale into a subsequent phase's check.
		loop {
			await (levelAtTargetPulse);
			abort (doseTargetMl) {
				sustain levelAtTarget;
			}
		}
	}
}