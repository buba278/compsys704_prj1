import run.LabellerGUI;
import run.ConveyorLabellerBridge;
import run.LabellerSorterBridge;

LabellerPlant(
   	output signal labelPrinted;
 	output signal bottleClamped;
 	output signal labelApplied;
 	output signal bottleAtLabeller;

    input signal printLabel;
    input signal clampBottle;
    input signal applyLabel;
    input Integer signal liquidARatio, targetVolumeMl;
    input signal bottleFromConveyor;
    input signal sorterTakenAck;

    output signal bottleAtLabellerE;
	output signal labelPrintedE;
	output signal bottleClampedE;
	output signal labelAppliedE;
	output Integer signal liquidARatioE, targetVolumeMlE;
)
->
{ new Thread(new LabellerGUI()).start();
	System.out.println("LabellerPlant: Subsystem initialized.");

	{
		// 0. Bottle arrival: real handoff from the Conveyor's collection
		// point, via ConveyorLabellerBridge (see conveyorPlant.sysj for the
		// other side of this handshake), rather than free-running.
		while(true){
			await(bottleFromConveyor);
			// commit to taking the bottle: ack back to the Conveyor so it
			// can drop its offer, same two-phase shape as the Pos1 handoff
			// in rotaryTableController.sysj.
			ConveyorLabellerBridge.setLabellerTakenAck(true);
			System.out.println("LabellerPlant [Conveyor]: Presenting bottle at labeller...");
			abort(clampBottle){
				sustain bottleAtLabeller;
			}
			System.out.println("LabellerPlant [Conveyor]: Bottle clamped, holding position...");
			// complete the handshake: wait for the Conveyor to see our ack
			// and drop its own offer before we drop ours.
			await(!bottleFromConveyor);
			ConveyorLabellerBridge.setLabellerTakenAck(false);
			// Don't re-present a bottle until the current one has actually been
			// released - clampBottle is held high for the whole print/clamp/apply
			// phase, so without this wait we immediately loop back around and
			// re-trigger the abort every tick, which is what made the bottle
			// flash on/off continuously while nothing else appeared to progress.
			await(!clampBottle);
			System.out.println("LabellerPlant [Conveyor]: Bottle released, ready for next.");

			// hand the finished bottle off to the Sorter. Ack-or-timeout
			// hold via LabellerSorterBridge, same shape as the Rotary
			// Table -> Capper handoff in rotaryTablePlant.sysj.
			abort(sorterTakenAck) {
				long tSort = System.currentTimeMillis();
				while (System.currentTimeMillis() - tSort < 5000) {
					LabellerSorterBridge.setBottleFromLabeller(true);
					pause;
				}
			}
			LabellerSorterBridge.setBottleFromLabeller(false);
			await(!sorterTakenAck);
		}
	}
	||
	{
		// 1. Label printing simulation
		while(true){
            await(printLabel);
            System.out.println("LabellerPlant [Printer]: Printing label...");
            abort(!printLabel){
                sustain labelPrinted;
            }
            pause;
        }
	}
	||
	{
		// 2. Bottle clamp simulation
		while(true){
			await(clampBottle);
			System.out.println("LabellerPlant [Clamp]: Clamping bottle...");
			abort(!clampBottle){
				sustain bottleClamped;
			}
			System.out.println("LabellerPlant [Clamp]: Bottle released.");
			pause;
		}
	}
	||
	{
		// 3. Label application simulation
		while(true){
            await(applyLabel);
            System.out.println("LabellerPlant [Applicator]: Applying label...");
            abort(!applyLabel){
                sustain labelApplied;
            }
            pause;
        }
	}
	||
    {while(true){present(bottleAtLabeller){emit bottleAtLabellerE;} pause;}}
    ||
    {while(true){present(labelPrinted){emit labelPrintedE;} pause;}}
    ||
    {while(true){present(bottleClamped){emit bottleClampedE;} pause;}}
    ||
    {while(true){present(labelApplied){emit labelAppliedE;} pause;}}
    ||
    {
        // Mirrors the Coordinator's recipe for this batch into the GUI, so
        // the bottle drawn here matches what the Filler actually put in it,
        // same shape as the other viz-mirror threads above.
        while(true){
            present(liquidARatio){ emit liquidARatioE((Integer)#liquidARatio); }
            present(targetVolumeMl){ emit targetVolumeMlE((Integer)#targetVolumeMl); }
            pause;
        }
    }
}

