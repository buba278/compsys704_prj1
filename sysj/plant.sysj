import run.GUI;
import run.LidFaultState;

Plant(
		input signal pusherExtend,vacOn,armSource,armDest;
		input signal enable,refill;
		input signal dropLidM;										// GUI -> plant (manual fault injection: lid slips out of grip, never gripped)
		output signal pusherRetracted,pusherExtended,WPgripped,armAtSource,armAtDest,empty;
		output signal pusherRetractedE,pusherExtendedE,WPgrippedE,armAtSourceE,armAtDestE,emptyE;
		output Integer signal capCountE;								// plant -> UI viz (remaining caps in the magazine, for a real per-cap depiction)
		)
->
{
	new Thread(new GUI()).start();
	

	signal capDec;
	int signal capPos;
	emit capPos(0);
	{// Arm
		while(true){
			abort(armSource && enable){
				sustain armAtDest;
			}
			await(!enable);
			abort(armDest && enable){
				sustain armAtSource;
			}
			await(!enable);
		}
	}
	||
	{// Pusher
		while(true){
			abort(pusherExtend && enable){
				sustain pusherRetracted;
			}
			await(!enable);
			abort(!pusherExtend && enable){
				sustain pusherExtended;
			}
			await(!enable);
		}
	}
	||
	{// Vacuum
		while(true){
			present(vacOn && armAtSource){
				if((Integer)#capPos == 1){
					emit capPos(0);
					if (!LidFaultState.isDropArmed()) {
						abort(!vacOn){
							sustain WPgripped;
						}
						present(armAtSource){
							emit capPos(1);
						}
					} else {
						// Dropped: the lid slips out before WPgripped ever
						// asserts - the controller's own per-attempt timeout
						// (not this plant) is what notices and retries, see
						// run.LidFaultState and the IP report.
						System.out.println("Plant [Vacuum]: DROPPED - lid slipped, never gripped");
						await(!vacOn);
						emit capPos(1);
					}
				}
			}
			pause;
		}
	}
	||
	{
		// Latches the GUI's "Drop Lid" manual fault trigger - mirrors
		// FillerPlant's overfillM/stallM bridging thread.
		while(true){
			present(dropLidM){
				LidFaultState.armDrop();
			}
			pause;
		}
	}
	||
	{
		/*
		 * Cap positions
		 * 0 = at Mag
		 * 1 = at pick-up
		 */
		while(true){
			// At mag
			abort(empty){
				while(true){
						await(pusherRetracted);
						await(pusherExtended);
						// At pick-up
						emit capPos(1);
						await(pusherRetracted);
						emit capDec;
				}
			}
			await(refill);
		}
	}
	||
	{
		int capcount = 5;
		while(true){
			present(capDec){
				if(capcount > 0)
					capcount--;
			}
			present(refill){
				capcount = 5;
			}
//			present(pusherRetracted){
				if(capcount == 0)
					emit empty;
//			}
			// Re-broadcast every tick (not gated), same reliability pattern as
			// emptyE below - the receiver always gets the current count even
			// if a single packet is dropped.
			emit capCountE(capcount);
			pause;
		}
	}
	||
	{// To viz
		{while(true){present(pusherRetracted){emit pusherRetractedE;} pause;}}
		||
		{while(true){present(pusherExtended){emit pusherExtendedE;} pause;}}
		||
		{while(true){present(WPgripped){emit WPgrippedE;} pause;}}
		||
		{while(true){present(armAtSource){emit armAtSourceE;} pause;}}
		||
		{while(true){present(armAtDest){emit armAtDestE;} pause;}}
		||
		{while(true){present(empty){emit emptyE;} pause;}}
	}
}
