FillerController(
    input signal bottleAtPos2; 								// turntable -> fillerController
    input Integer signal liquidARatio, targetVolumeMl;		// orchestrator -> fillerController
    input signal levelAtTarget;								// fillerPlant -> fillerController
    output Integer signal doseTargetMl;						// fillerController -> fillerPlant
    output signal valve1Open, valve2Open, fillDone;			// fillerController -> fillerPlant
    output signal fillDoneE; 								// fillerController -> turntable
)
-> 
{
	{
		loop {
			await (bottleAtPos2);
			// scale liquids by ratios
			int aTarget = ((Integer)#targetVolumeMl * (Integer)#liquidARatio / 100);
			int bTarget = (Integer)#targetVolumeMl; // just check total for last liquid
			
			emit doseTargetMl(aTarget);
			abort (levelAtTarget) {
				sustain valve1Open;
			}
			emit doseTargetMl(bTarget);
			abort (levelAtTarget) {
				sustain valve2Open;
			}
			
			emit fillDone;
			await (!bottleAtPos2);
		}
	}
	||
	{
		loop {
			{
				present (fillDone) {
					emit fillDoneE;
				}
			}
		}
	}
}