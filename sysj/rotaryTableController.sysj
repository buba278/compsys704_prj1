rotaryTableController(
		input signal tableAlignedWithSensor, bottleAtPos5, capOnBottleAtPos1, readyToRotate;
		output signal rotaryTableTrigger, tableRotationComplete;
		input Integer signal mode;
		input signal rotateM; // manually rotate table
		)
->
{
	signal autoMode; 	// 0
	signal manualMode; 	// 1

	{	// mode selection
		int currentMode = 0; // default is auto mode

		loop {
			present(mode) {
				currentMode = (Integer)#mode;
			}
			if (currentMode == 1) {
				emit manualMode;
			}
			else {
				emit autoMode;
			}
			pause;
		}
	}
	||
	{ 	// auto mode

		loop {

			await(autoMode);

			abort(manualMode) {
				await(readyToRotate);

				// don't start rotating a new bottle in until the previous
				// one has actually cleared Position 5
				present(bottleAtPos5) {
					await(!bottleAtPos5);
				}

				present(capOnBottleAtPos1) {
					await(!capOnBottleAtPos1);
				}

				abort(tableAlignedWithSensor) {
					loop {
						emit rotaryTableTrigger;
						pause;
					}
				}

				emit tableRotationComplete;
				pause;
			}
		}
	}
	||
	{	// manual mode
		loop {
			await(manualMode);

			abort(autoMode) {
				loop {
					present(rotateM) {
						emit rotaryTableTrigger;
					}
					pause;
				}
			}
		}
	}

}
