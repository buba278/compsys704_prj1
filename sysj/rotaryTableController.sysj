import run.RotaryConveyorBridge;
import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;

rotaryTableController(
		input signal tableAlignedWithSensor, bottleAtPos5, readyToRotate;
		input signal tableBusy, tableHasFreeSlot;
		output signal rotaryTableTrigger;
		input Integer signal mode;
		input signal rotateM; // manually rotate table
		)
->
{
	signal autoMode; 	// 0
	signal manualMode; 	// 1

	// Ack side of the Pos 1 handoff with the Conveyor, held true until the Conveyor drops its own request - keeps the handoff correct regardless of either side's tick rate.
	// Sent via RotaryConveyorBridge (run-package class) not an inline SignalLevelClient - sjc crashes resolving multi-segment package types in a reactive body.

	{	// mode selection
		int currentMode = 0; // default is auto mode

		loop {
			present(mode) {
				currentMode = (Integer)#mode;
			}
			if (currentMode == 1) {
				emit manualMode;
			}
			else {
				emit autoMode;
			}
			pause;
		}
	}
	||
	{ 	// auto mode
	TwinClient twin = new TwinClient("rotary-table", "127.0.0.1", 9090);

		loop {

			await(autoMode);

			abort(manualMode) {
				// A new bottle can only be accepted once the Entry slot (Pos 1) is genuinely free - wait for the Plant to report that.
				await(tableHasFreeSlot);

				await(readyToRotate);


				abort(tableAlignedWithSensor) {
					loop {
						emit rotaryTableTrigger;
						twin.reportRotaryTurn();
						pause;
					}
				}
				

				// Ack only after tableAlignedWithSensor (genuine dispatch), not the instant we start trying - acking earlier lets the Conveyor release Pos 1 before the bottle has actually entered the table.
				RotaryConveyorBridge.setPos1AckToController(true);
				RotaryConveyorBridge.setPos1AckToPlant(true);

				// complete the handshake: wait for the Conveyor Controller
				// to see our ack and drop its request before we drop ours,
				// so the ack can't be missed and this is safely re-armed
				// for the next bottle.
				await(!readyToRotate);
				RotaryConveyorBridge.setPos1AckToController(false);
				RotaryConveyorBridge.setPos1AckToPlant(false);

				pause;
			}
		}
	}
	||
	{	// manual mode
	TwinClient twin = new TwinClient("rotary", "127.0.0.1", 9090);
		loop {
			await(manualMode);

			abort(autoMode) {
			
				loop {
					present(rotateM) {
						emit rotaryTableTrigger;
						twin.reportRotaryTurn();
						pause;
						
					}
					pause;
				}
			}
			
   			
		}
	}

}
