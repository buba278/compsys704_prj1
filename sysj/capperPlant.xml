<System xmlns="http://systemjtechnology.com">
      <SubSystem Name="SS2" Local="true">
              <ClockDomain Name="CapperPlantCD" Class="CapperPlant">
                      <!-- Input Signals received from the CapperControllerCD -->
                      <iSignal Name="sendGripperDown"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10011" />
                      <iSignal Name="sendGripperTwist"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10011" />
                      <iSignal Name="sendGripperUntwist" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10011" />
                      <iSignal Name="sendGripCap"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10011" />
                      <iSignal Name="sendClamp"          Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10011" />
                      <iSignal Name="bottleAtPos4" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10011"/>
                      <iSignal Name="capperStallM"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10011"/>

                      <!-- Output Signals transmitted back to the CapperControllerCD -->
                      <oSignal Name="gripperMaxLower"  To="CapperControllerCD.gripperMaxLower"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10010" />
                      <oSignal Name="gripperMaxLift"   To="CapperControllerCD.gripperMaxLift"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10010" />
                      <oSignal Name="capGripped"       To="CapperControllerCD.capGripped"       Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10010" />
                      <oSignal Name="gripperInitPos"   To="CapperControllerCD.gripperInitPos"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10010" />
                      <oSignal Name="gripperFullTwist" To="CapperControllerCD.gripperFullTwist" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10010" />
                      
                      <oSignal Name="bottleAtPos4E"      To="UI.bottleAtPos4E"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
                      <oSignal Name="bottleGoneE"        To="UI.bottleGoneE"        Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
                      <oSignal Name="gripperMaxLowerE"   To="UI.gripperMaxLowerE"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
                      <oSignal Name="gripperMaxLiftE"    To="UI.gripperMaxLiftE"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
                      <oSignal Name="gripperInitPosE"    To="UI.gripperInitPosE"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
                      <oSignal Name="gripperFullTwistE"  To="UI.gripperFullTwistE"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
              </ClockDomain>
      </SubSystem>
</System>
