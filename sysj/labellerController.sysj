import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;

LabellerController(
    input signal bottleAtLabeller; 								
    input signal labelPrinted;
    input signal bottleClamped;
    input signal labelApplied;
 
    output signal printLabel;
    output signal clampBottle;
    output signal applyLabel;			
)
->
{
	TwinClient twin = new TwinClient("labeller", "127.0.0.1", 9090);
	System.out.println("LabelController: Initialized and running.");

	loop {
		twin.update(PlantTwin.State.IDLE);
		System.out.println("LabelController: Waiting for bottle at labeller...");
		await (bottleAtLabeller);
		
		String productId = twin.getProductIdAtPosition(4);
		if (productId == null || productId.isEmpty()) {
			productId = "UNKNOWN";
		}
		
		System.out.println("LabelController: Bottle detected. Starting sequence...");
		twin.update(PlantTwin.State.IN_PROGRESS);

		// Step 1: Print Label (Hold for 700ms)
		long tPrint = System.currentTimeMillis();
		while (System.currentTimeMillis() - tPrint < 700) {
			emit printLabel;
			pause;
		}
		// FIX: Deleted await(labelPrinted) here
		System.out.println("LabelController: Label printed. Clamping bottle...");

		// Step 2: Clamp Bottle (Hold for 700ms)
		long tClamp = System.currentTimeMillis();
		while (System.currentTimeMillis() - tClamp < 700) {
			emit clampBottle;
			pause;
		}
		// FIX: Deleted await(bottleClamped) here
		System.out.println("LabelController: Bottle clamped. Applying label...");

		// Step 3: Apply Label (Hold clamp & apply for 1000ms)
		long tApply = System.currentTimeMillis();
		while (System.currentTimeMillis() - tApply < 1000) {
			emit clampBottle;
			emit applyLabel;
			pause;
		}
		// FIX: Deleted await(labelApplied) here

		twin.recordEvent("Label applied", productId);
		System.out.println("LabelController: Label applied, Release complete.");

		twin.update(PlantTwin.State.IDLE);

		// await isn't edge-triggered - re-check !bottleAtLabeller so this doesn't re-fire on the same still-present bottle.
		await(!bottleAtLabeller);
	}
}