import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;
LabellerController(
    input signal bottleAtLabeller; 								
    //input Integer signal liquidARatio, targetVolumeMl;		
 	input signal labelPrinted;
 	input signal bottleClamped;
 	input signal labelApplied;
 
    output signal printLabel;
    output signal clampBottle;
    output signal applyLabel;							
)
->
{
	TwinClient twin = new TwinClient("labeller", "127.0.0.1", 9090);
	System.out.println("LabelController: Initialized and running.");
	loop {
		twin.update(PlantTwin.State.IDLE);
		System.out.println("LabelController: Waiting for bottle at labeller...");
		await (bottleAtLabeller);
		System.out.println("LabelController: Bottle detected. Sending print command...");
		twin.update(PlantTwin.State.IN_PROGRESS);
        abort(labelPrinted){
            sustain printLabel;
        }
        System.out.println("LabelController: Label printed. Clamping bottle...");

		abort(labelApplied){
			{
				sustain clampBottle;
			}
			||
			{
				await (bottleClamped);
            	System.out.println("LabelController: Bottle clamped. Applying label...");
            	sustain applyLabel;
			}
		}
		twin.recordEvent("Label applied", null);
		System.out.println("LabelController: Label applied. Releasing clamp. Cycle complete.");
		twin.update(PlantTwin.State.IDLE);
		
	}
}