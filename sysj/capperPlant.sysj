import run.CapperGUI;
import run.CapperFaultState;

CapperPlant(
    input signal sendGripperDown;
    input signal sendGripperTwist;
    input signal sendGripperUntwist;
    input signal sendGripCap;
    input signal sendClamp;
    input signal bottleAtPos4;
    input signal capperJamM;								// GUI -> capperPlant (manual fault injection: cap knocked off, twist never completes)

    output signal gripperMaxLower;
    output signal gripperMaxLift;
    output signal capGripped;
    output signal gripperInitPos;
    output signal gripperFullTwist;

    output signal bottleAtPos4E;
    output signal bottleGoneE;
    output signal gripperMaxLowerE;
    output signal gripperMaxLiftE;
    output signal gripperInitPosE;
    output signal gripperFullTwistE;
)
->
{
	new Thread(new CapperGUI()).start();
    System.out.println("CapperPlant: Subsystem initialized.");

   
    {
        // 2. Gripper Z-axis movement simulation
        while(true){
            abort(sendGripperDown){
                sustain gripperMaxLift;
            }
            System.out.println("CapperPlant [Z-Axis]: Moving down...");
            pause;
            pause;

            System.out.println("CapperPlant [Z-Axis]: Reached bottom sensor.");
            abort(!sendGripperDown){
                sustain gripperMaxLower;
            }
            System.out.println("CapperPlant [Z-Axis]: Moving back up...");
            pause;
            pause;
        }
    }
    ||
    {
        // 3. Cap Gripper simulation
        while(true){
            // Standby until controller asks to grip the cap
            await(sendGripCap);
            System.out.println("CapperPlant [Gripper Jaw]: Closing jaws around cap...");

            abort(!sendGripCap){
                sustain capGripped;
            }
            System.out.println("CapperPlant [Gripper Jaw]: Jaws opened, cap released.");
            pause;
        }
    }
    ||
    {
        // 4. Gripper rotation simulation
        while(true){
            abort(sendGripperTwist){
                sustain gripperInitPos;
            }
            System.out.println("CapperPlant [Rotation]: Twisting cap closed...");
            pause;
            pause;

            if (!CapperFaultState.isJamArmed()) {
                System.out.println("CapperPlant [Rotation]: Full twist achieved.");
                abort(sendGripperUntwist){
                    sustain gripperFullTwist;
                }
            } else {
                // Jammed: cap knocked loose before reaching full twist -
                // gripperFullTwist never asserts, so the controller's own
                // per-attempt timeout (not this plant) is what notices and
                // retries - see run.CapperFaultState and the IP report.
                System.out.println("CapperPlant [Rotation]: JAMMED - cap slipped, full twist never achieved");
                await(!sendGripperTwist);
            }
            System.out.println("CapperPlant [Rotation]: Untwisting back to start position...");
            pause;
            pause;
        }

    }
    ||
    {
        // Latches the GUI's "Jam Twist" manual fault trigger - mirrors
        // FillerPlant's overfillM/stallM bridging thread.
        while(true){
            present(capperJamM){
                CapperFaultState.armJam();
            }
            pause;
        }
    }
    ||
     //To viz
		{
			while(true){
				present(bottleAtPos4){
					emit bottleAtPos4E;
				} else {
					emit bottleGoneE;
				}
				pause;
			}
		}
		||
		{while(true){present(gripperMaxLower){emit gripperMaxLowerE;} pause;}}
		||
		{while(true){present(gripperMaxLift){emit gripperMaxLiftE;} pause;}}
		||
		{while(true){present(gripperInitPos){emit gripperInitPosE;} pause;}}
		||
		{while(true){present(gripperFullTwist){emit gripperFullTwistE;} pause;}}


}
