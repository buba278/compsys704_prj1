import run.RotaryConveyorBridge;

conveyorController(
		input signal bottleAtPos1, bottleLeftPos5, pos1TakenAck;
		output signal motConveyorOnOff;
		input Integer signal mode;
		input signal conveyorM;
		)
->
{
	signal autoMode, manualMode;

	// Direct controller-to-controller handoff with the Rotary Table
	// Controller. This replaces the old approach of piggy-backing the
	// handoff on the bottleAtPos1E *visualisation* event inside
	// ConveyorVizWorker, which tied a physical handoff to whatever fixed
	// number of ticks the plant happened to hold that GUI event for.
	// readyToRotate (the request) is held true for as long as there is a
	// bottle waiting at Pos 1, and is only dropped once the Rotary Table
	// has acknowledged it via pos1TakenAck - see rotaryTableController.sysj
	// and conveyorPlant.sysj for the other two legs of this handshake.
	// Sent via RotaryConveyorBridge (a single-segment "run" package class)
	// rather than declaring the SignalLevelClient inline here - this build
	// of sjc crashes resolving types from multi-segment packages such as
	// org.compsys704 when used for a local instance declaration inside a
	// .sysj reactive body (confirmed by isolated repro).

	{ // mode selection
		int currentMode = 0; // default is auto mode
		loop {
			present(mode) {
				currentMode = (Integer)#mode;
			}
			if (currentMode == 1) {
				emit manualMode;
			}
			else {
				emit autoMode;
			}
			pause;
		}
	}
	||
	{ // auto mode
		loop {
			await(autoMode);
			abort(manualMode) {
				boolean handoffPending = false;
				boolean sawTakenAck = false;
				loop {
					present(bottleAtPos1) {
						// Don't tell the Rotary Table it's safe to rotate the
						// instant the model signals arrival - the on-screen
						// bottle (eased toward this same model progress in
						// ConveyorCanvas) needs a little longer to visually
						// settle at the Pos 1 marker. handoffPending guards
						// this so the wait only starts once per bottle rather
						// than re-arming every tick bottleAtPos1 stays present.
						if (!handoffPending) {
							handoffPending = true;
							long tArrive = System.currentTimeMillis();
							while (System.currentTimeMillis() - tArrive < 200) { pause; }
							RotaryConveyorBridge.setReadyToRotate(true);
							System.out.printf("Conveyor: bottle at Pos 1 - handing to Rotary Table%n");
						}
					}
					present(pos1TakenAck) {
						// Rotary Table has committed to taking the bottle -
						// safe to drop our request now. The plant is
						// watching the same ack independently to release
						// bottleAtPos1 on its side. Only act on the rising
						// edge - pos1TakenAck stays present for the whole
						// cross-process round trip, and present() isn't
						// edge-triggered, so re-running this every tick could
						// reset handoffPending while bottleAtPos1 is still
						// transiently present too, letting the block above
						// re-arm and send a second, phantom readyToRotate for
						// a bottle that's already been taken - see CLAUDE.md
						// and the resulting extra rotary table lane dispatch
						// this caused.
						if (!sawTakenAck) {
							sawTakenAck = true;
							handoffPending = false;
							RotaryConveyorBridge.setReadyToRotate(false);
							System.out.printf("Conveyor: Rotary Table has taken the bottle from Pos 1%n");
						}
					} else {
						sawTakenAck = false;
					}
					present(bottleLeftPos5) {
						System.out.printf("Conveyor: bottle travelling to collection point%n");
					}
					pause;
				}
			}
		}
	}
	||
	{ // manual mode
		loop {
			await(manualMode);
			abort(autoMode) {
				loop {
					present(conveyorM) {
						emit motConveyorOnOff;
					}
					pause;
				}
			}
		}
	}
}
