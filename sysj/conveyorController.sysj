import run.RotaryConveyorBridge;
import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;

conveyorController(
		input signal bottleAtPos1, bottleLeftPos5, pos1TakenAck;
		output signal motConveyorOnOff;
		input Integer signal mode;
		input signal conveyorM;
		)
->
{
	signal autoMode, manualMode;

	// Direct handoff to the Rotary Table Controller via RotaryConveyorBridge; readyToRotate stays held until pos1TakenAck clears it.
	// Uses the "run" package bridge class, not an inline SignalLevelClient - sjc crashes resolving multi-segment package types in a reactive body.

	{ // mode selection
		int currentMode = 0; // default is auto mode
		loop {
			present(mode) {
				currentMode = (Integer)#mode;
			}
			if (currentMode == 1) {
				emit manualMode;
			}
			else {
				emit autoMode;
			}
			pause;
		}
	}
	||
	{ // auto mode
		loop {
			await(autoMode);
			abort(manualMode) {
				// Each present() block needs its own independent edge guard on its own signal - sharing one "pending" flag between blocks lets a phantom second handoff slip through.
				boolean sawBottleAtPos1 = false;
				boolean sawTakenAck = false;
				boolean sawBottleLeftPos5 = false;
				loop {
					present(bottleAtPos1) {
						if (!sawBottleAtPos1) {
							sawBottleAtPos1 = true;
							// Delay so the on-screen bottle visually settles at the Pos 1 marker before signalling ready-to-rotate.
							long tArrive = System.currentTimeMillis();
							while (System.currentTimeMillis() - tArrive < 200) { pause; }
							RotaryConveyorBridge.setReadyToRotate(true);
							System.out.printf("Conveyor: bottle at Pos 1 - handing to Rotary Table%n");
						}
					} else {
						sawBottleAtPos1 = false;
					}
					present(pos1TakenAck) {
						// Edge-guarded: pos1TakenAck stays present for the whole round trip and present() isn't edge-triggered.
						if (!sawTakenAck) {
							sawTakenAck = true;
							RotaryConveyorBridge.setReadyToRotate(false);
							System.out.printf("Conveyor: Rotary Table has taken the bottle from Pos 1%n");
						}
					} else {
						sawTakenAck = false;
					}
					present(bottleLeftPos5) {
						// Edge-guarded: held present for up to 30s, and unguarded logging here would busy-spin the process at unthrottled tick speed.
						if (!sawBottleLeftPos5) {
							sawBottleLeftPos5 = true;
							System.out.printf("Conveyor: bottle travelling to collection point%n");
						}
					} else {
						sawBottleLeftPos5 = false;
					}
					pause;
				}
			}
		}
	}
	||
	{ // manual mode
		loop {
			await(manualMode);
			abort(autoMode) {
				loop {
					present(conveyorM) {
						emit motConveyorOnOff;
					}
					pause;
				}
			}
		}
	}
}
