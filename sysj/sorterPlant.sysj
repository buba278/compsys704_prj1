import run.SorterGUI;

SorterPlant(
    input signal extendPusher;
    input signal coordBottleAtSorter;     // External Coordinator signal (Auto Mode)

    // Manual Mode Inputs (from Java UI)
    input signal manualMode;
    input signal manualBottleAtSorter;
    input signal manualBottleDefective;

    // Output signals sent to SorterController
    output signal bottleAtSorter;
    output signal bottleDefective;
    output signal pusherExtended;
    output signal pusherRetracted;

    // Visualizer mirror outputs
    output signal bottleAtSorterE;
    output signal bottleDefectiveE;
    output signal pusherExtendedE;
    output signal pusherRetractedE;
)
->
{
    System.out.println("SorterPlant: Subsystem initialized.");
    new Thread(new SorterGUI()).start();

    {
        // 1. Bottle Presence Multiplexer (No auto-timer simulation)
        while (true) {
            present (manualMode) {
                // MANUAL MODE: UI checkbox drives bottle presence
                present (manualBottleAtSorter) {
                    emit bottleAtSorter;
                }
            } else {
                // AUTO MODE: Pass-through external Coordinator signal
                present (coordBottleAtSorter) {
                    emit bottleAtSorter;
                }
            }
            pause;
        }
    }
    ||
    {
        // 2. Defect Sensor Logic
        while (true) {
            present (manualMode) {
                // MANUAL MODE: UI checkbox drives defect signal
                present (manualBottleDefective) {
                    emit bottleDefective;
                }
                pause;
            } else {
                // AUTO MODE: Random defect sensor on bottle arrival
                await (bottleAtSorter);
                if (Math.random() < 0.25) {
                    System.out.println("SorterPlant [Sensor]: Defect detected on bottle!");
                    abort (!bottleAtSorter || manualMode) {
                        sustain bottleDefective;
                    }
                } else {
                    await (!bottleAtSorter || manualMode);
                }
            }
        }
    }
    ||
    {
        // 3. Pusher Actuator Simulation (Pacing ticks for smooth animation)
        while (true) {
            abort (extendPusher) {
                sustain pusherRetracted;
            }
            System.out.println("SorterPlant [Pusher]: Extending...");
            pause; pause; pause;

            System.out.println("SorterPlant [Pusher]: Fully extended.");
            abort (!extendPusher) {
                sustain pusherExtended;
            }
            System.out.println("SorterPlant [Pusher]: Retracting...");
            pause; pause; pause;
        }
    }
    ||
    // Viz Mirror Outputs
    {
        {while(true){present(bottleAtSorter){emit bottleAtSorterE;} pause;}}
        ||
        {while(true){present(bottleDefective){emit bottleDefectiveE;} pause;}}
        ||
        {while(true){present(pusherExtended){emit pusherExtendedE;} pause;}}
        ||
        {while(true){present(pusherRetracted){emit pusherRetractedE;} pause;}}
    }
}