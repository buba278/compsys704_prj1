import run.SorterGUI;

SorterPlant(
    input signal extendPusher;
    input signal bottleFromLabeller;      // Labeller -> Sorter handoff (Auto Mode)
    input signal bottleDefectiveFromLabeller; // Labeller -> Sorter (real outcome: was this bottle abandoned upstream?)

    // Manual Mode Inputs (from Java UI)
    input signal manualMode;
    input signal manualBottleAtSorter;
    input signal manualBottleDefective;

    // Output signals sent to SorterController
    output signal bottleAtSorter;
    output signal bottleDefective;
    output signal pusherExtended;
    output signal pusherRetracted;

    // Visualizer mirror outputs
    output signal bottleAtSorterE;
    output signal bottleDefectiveE;
    output signal pusherExtendedE;
    output signal pusherRetractedE;
    output Integer signal sortedCountE, rejectedCountE;

    output signal bottleAtSorterBigE;
    output signal bottleDefectiveBigE;
    output signal pusherExtendedBigE;
    output signal pusherRetractedBigE;
    output Integer signal sortedCountBigE, rejectedCountBigE;
)
->
{
    System.out.println("SorterPlant: Subsystem initialized.");
    new Thread(new SorterGUI()).start();

    {
        // 1. Bottle Presence Multiplexer (No auto-timer simulation)
        while (true) {
            present (manualMode) {
                // MANUAL MODE: UI checkbox drives bottle presence
                present (manualBottleAtSorter) {
                    emit bottleAtSorter;
                }
            } else {
                // AUTO MODE: Pass-through the Labeller's handoff
                present (bottleFromLabeller) {
                    emit bottleAtSorter;
                }
            }
            pause;
        }
    }
    ||
    {
        // 2. Defect Sensor Logic
        int sortedCount = 0;
        int rejectedCount = 0;
        while (true) {
            present (manualMode) {
                // MANUAL MODE: UI checkbox drives defect signal
                present (manualBottleDefective) {
                    emit bottleDefective;
                }
                pause;
            } else {
                // AUTO MODE: reject based on a real upstream fault (unfilled/no lid/uncapped) carried via bottleDefectiveFromLabeller, not a coin flip; latched instantly since the Labeller asserts both in lockstep.
                await (bottleAtSorter);
                boolean defective;
                present (bottleDefectiveFromLabeller) {
                    defective = true;
                } else {
                    defective = false;
                }
                if (defective) {
                    System.out.println("SorterPlant [Sensor]: Defect detected on bottle!");
                    abort (!bottleAtSorter || manualMode) {
                        sustain bottleDefective;
                    }
                    rejectedCount = rejectedCount + 1;
                    // Widened hold, not a bare single-tick emit - this crosses the socket to the UI process.
                    {
                        long tCount = System.currentTimeMillis();
                        while (System.currentTimeMillis() - tCount < 100) { emit rejectedCountE(rejectedCount); emit rejectedCountBigE(rejectedCount); pause; }
                    }
                } else {
                    await (!bottleAtSorter || manualMode);
                    sortedCount = sortedCount + 1;
                    {
                        long tCount = System.currentTimeMillis();
                        while (System.currentTimeMillis() - tCount < 100) { emit sortedCountE(sortedCount); emit sortedCountBigE(sortedCount); pause; }
                    }
                }
            }
        }
    }
    ||
    {
        // 3. Pusher Actuator Simulation
        // Wall-clock paced, not just a few bare ticks - at unthrottled tick speed a handful of pauses is imperceptibly fast.
        while (true) {
            abort (extendPusher) {
                sustain pusherRetracted;
            }
            System.out.println("SorterPlant [Pusher]: Extending...");
            {
                long tExtend = System.currentTimeMillis();
                while (System.currentTimeMillis() - tExtend < 350) { pause; }
            }

            System.out.println("SorterPlant [Pusher]: Fully extended.");
            abort (!extendPusher) {
                sustain pusherExtended;
            }
            System.out.println("SorterPlant [Pusher]: Retracting...");
            {
                long tRetract = System.currentTimeMillis();
                while (System.currentTimeMillis() - tRetract < 350) { pause; }
            }
        }
    }
    ||
    // Viz Mirror Outputs
    {
        {while(true){present(bottleAtSorter){emit bottleAtSorterE; emit bottleAtSorterBigE;} pause;}}
        ||
        {while(true){present(bottleDefective){emit bottleDefectiveE; emit bottleDefectiveBigE;} pause;}}
        ||
        {while(true){present(pusherExtended){emit pusherExtendedE; emit pusherExtendedBigE;} pause;}}
        ||
        {while(true){present(pusherRetracted){emit pusherRetractedE; emit pusherRetractedBigE;} pause;}}
    }
}