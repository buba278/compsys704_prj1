import run.ConveyorGUI;
import run.ConveyorLabellerBridge;
import run.RotaryConveyorBridge;
import run.ConveyorCoordinatorBridge;
import run.LoaderState;
import run.TableOccupancy;
import run.ConveyorRecipe;

conveyorPlant(
		input signal motConveyorOnOff;
		input signal enable, loadBottle, bottleFromTable, pos1TakenAck;
		input signal labellerTakenAck;
		input signal bottleDefectiveFromTable;
		input Integer signal bottlesNeeded;
		input Integer signal liquidARatioC;                    
		output signal bottleAtPos1, bottleLeftPos5;
		output signal bottleAtPos1E, bottleLeftPos5E, motorOnE;
		output signal bottleEnteredE;
		output Integer signal bottleReceivedE;
		output signal leftMovingE, rightMovingE;
		output Integer signal bottlesOnTableE;
		output signal bottleAtPos1BigE, bottleLeftPos5BigE, motorOnBigE;
		output signal bottleEnteredBigE;
		output Integer signal bottleReceivedBigE;
		output signal leftMovingBigE, rightMovingBigE;
		)
->
{
	new Thread(new ConveyorGUI()).start();

	signal leftMoving, rightMoving;

	signal autoLoadBottle;

	{ 
		while(true){
			present(motConveyorOnOff){ emit motorOnE; emit motorOnBigE; }
			present(leftMoving){ emit motorOnE; emit motorOnBigE; }
			present(rightMoving){ emit motorOnE; emit motorOnBigE; }
			pause;
		}
	}
	||
	{
		boolean sawBottlesNeeded = false;
		while(true){
			present(bottlesNeeded){
				if (!sawBottlesNeeded) {
					sawBottlesNeeded = true;
					LoaderState.addPending((Integer)#bottlesNeeded);
				}
				ConveyorCoordinatorBridge.setBottlesNeededAck(true);
			} else {
				sawBottlesNeeded = false;
				ConveyorCoordinatorBridge.setBottlesNeededAck(false);
			}
			pause;
		}
	}
	||
	{
		while(true){
			present(liquidARatioC){
				ConveyorRecipe.setRatio((Integer)#liquidARatioC);
			}
			pause;
		}
	}
	||
	{ 
		boolean printedWaiting = false;
		while(true){
			await(!bottleAtPos1);
			if (LoaderState.tryConsumePending()) {
				printedWaiting = false;
				System.out.printf("[Conveyor] auto-loader pulsing autoLoadBottle%n");
				long t0 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t0 < 300) { emit autoLoadBottle; pause; }
				await(bottleAtPos1);
			} else {
				if (!printedWaiting) {
					printedWaiting = true;
					System.out.printf("[Conveyor] auto-loader idle, nothing pending%n");
				}
				pause;
			}
		}
	}
	||
	{ 
		while(true){
			await(loadBottle || autoLoadBottle);
			await(enable);
			{
				long tEnter = System.currentTimeMillis();
				while (System.currentTimeMillis() - tEnter < 50) { emit bottleEnteredE; emit bottleEnteredBigE; pause; }
			}

			{
				long tSettle = System.currentTimeMillis();
				while (System.currentTimeMillis() - tSettle < 900) { pause; }
			}

			emit leftMoving; { long tL1 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL1 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;
			emit leftMoving; { long tL2 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL2 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;
			emit leftMoving; { long tL3 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL3 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;
			emit leftMoving; { long tL4 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL4 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;
			emit leftMoving; { long tL5 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL5 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;
			emit leftMoving; { long tL6 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL6 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;
			emit leftMoving; { long tL7 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL7 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;
			emit leftMoving; { long tL8 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL8 < 45) { emit leftMovingE; emit leftMovingBigE; pause; } } pause;

			abort(pos1TakenAck) {
				sustain bottleAtPos1;
			}
			
			{
				int onTable = TableOccupancy.increment();
				long tCount = System.currentTimeMillis();
				while (System.currentTimeMillis() - tCount < 100) { emit bottlesOnTableE(onTable); pause; }
			}
		}
	}
	||
	{
		while(true){
			await(bottleFromTable);
			await(enable);

			boolean defective;
			present (bottleDefectiveFromTable) {
				defective = true;
			} else {
				defective = false;
			}

			{
				int onTable = TableOccupancy.decrement();
				long tCount = System.currentTimeMillis();
				while (System.currentTimeMillis() - tCount < 100) { emit bottlesOnTableE(onTable); pause; }
			}

			{
				int exitRatio = ConveyorRecipe.getRatio();
				long tReceived = System.currentTimeMillis();
				while (System.currentTimeMillis() - tReceived < 50) { emit bottleReceivedE(exitRatio); emit bottleReceivedBigE(exitRatio); pause; }
			}

			emit rightMoving; { long tR1 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR1 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;
			emit rightMoving; { long tR2 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR2 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;
			emit rightMoving; { long tR3 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR3 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;
			emit rightMoving; { long tR4 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR4 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;
			emit rightMoving; { long tR5 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR5 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;
			emit rightMoving; { long tR6 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR6 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;
			emit rightMoving; { long tR7 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR7 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;
			emit rightMoving; { long tR8 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR8 < 45) { emit rightMovingE; emit rightMovingBigE; pause; } } pause;

			abort(labellerTakenAck) {
				long tLabel = System.currentTimeMillis();
				while (System.currentTimeMillis() - tLabel < 30000) {
					emit bottleLeftPos5;
					ConveyorLabellerBridge.setBottleFromConveyor(true);
					ConveyorLabellerBridge.setBottleDefectiveFromConveyor(defective);
					pause;
				}
			}
			ConveyorLabellerBridge.setBottleFromConveyor(false);
			ConveyorLabellerBridge.setBottleDefectiveFromConveyor(false);
			await(!labellerTakenAck);

			{
				long tAck = System.currentTimeMillis();
				while (System.currentTimeMillis() - tAck < 100) {
					RotaryConveyorBridge.setConveyorTakenAck(true);
					pause;
				}
			}
			RotaryConveyorBridge.setConveyorTakenAck(false);

			await(!bottleFromTable);
		}
	}
	||
	{ // Forward events to the GUI
		{while(true){present(bottleAtPos1){emit bottleAtPos1E; emit bottleAtPos1BigE;} pause;}}
		||
		{while(true){present(bottleLeftPos5){emit bottleLeftPos5E; emit bottleLeftPos5BigE;} pause;}}
	}
}
