import run.ConveyorGUI;
import run.ConveyorLabellerBridge;
import run.RotaryConveyorBridge;
import run.LoaderState;
import run.TableOccupancy;

conveyorPlant(
		input signal motConveyorOnOff;
		input signal enable, loadBottle, bottleFromTable, pos1TakenAck;
		input signal labellerTakenAck;
		input Integer signal bottlesNeeded;
		output signal bottleAtPos1, bottleLeftPos5;
		output signal bottleAtPos1E, bottleLeftPos5E, motorOnE;
		output signal bottleEnteredE, bottleReceivedE;
		output signal leftMovingE, rightMovingE;
		output Integer signal bottlesOnTableE;
		)
->
{
	new Thread(new ConveyorGUI()).start();

	// internal only (not echoed to the GUI directly) - true while a bottle is
	// physically translating on that segment of the belt, used purely to
	// drive the "motor running" indicator
	signal leftMoving, rightMoving;

	// Stands in for a real Bottle Loader station reacting to the Coordinator,
	// alongside the manual Load Bottle button - see LoaderState.
	signal autoLoadBottle;

	{ // Motor status echo to GUI: the belt visibly runs whenever it is
	  // actually transporting a bottle (auto) or being jogged manually
		while(true){
			present(motConveyorOnOff){ emit motorOnE; }
			present(leftMoving){ emit motorOnE; }
			present(rightMoving){ emit motorOnE; }
			pause;
		}
	}
	||
	{ // Latches the Coordinator's bottlesNeeded into LoaderState - a plain
	  // Java field is safe here since only this process ever touches it (see
	  // LoaderState; statics don't cross clock-domain processes, so this has
	  // to be a real signal from the Coordinator, converted to same-process
	  // state right here rather than shared directly).
		boolean sawBottlesNeeded = false;
		while(true){
			present(bottlesNeeded){
				// Only latch on the rising edge - bottlesNeeded is held present
				// for a wide window (see coordinator.sysj), and present() isn't
				// edge-triggered, so calling addPending() on every tick it's
				// held would add far more bottles than the order actually needs.
				if (!sawBottlesNeeded) {
					sawBottlesNeeded = true;
					LoaderState.addPending((Integer)#bottlesNeeded);
				}
			} else {
				sawBottlesNeeded = false;
			}
			pause;
		}
	}
	||
	{ // Auto-loader: feeds bottles in automatically as the Coordinator's
	  // orders need them, standing in for a real Bottle Loader station.
	  // Paced by bottleAtPos1 itself - only pulses a fresh autoLoadBottle
	  // once Pos 1 has actually cleared, so it can't outrun the left
	  // segment's own one-bottle-at-a-time pacing below.
		boolean printedWaiting = false;
		while(true){
			await(!bottleAtPos1);
			if (LoaderState.tryConsumePending()) {
				printedWaiting = false;
				System.out.printf("[Conveyor] auto-loader pulsing autoLoadBottle%n");
				// Held well past the left segment's own post-handoff overhead
				// (the TableOccupancy widened hold right after Pos1 clears,
				// ~100ms) - a shorter hold here can go absent again before the
				// left segment's while(true) loop ever gets back around to its
				// own await(loadBottle || autoLoadBottle) check, silently
				// dropping this pulse even though both threads are in the same
				// clock domain (same race as the cross-domain one in
				// CLAUDE.md, just without a socket in between). Confirmed via
				// timestamped diagnostics: a 50ms hold here reliably lost the
				// pulse to exactly that gap.
				long t0 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t0 < 300) { emit autoLoadBottle; pause; }
				// Only wait for bottleAtPos1 (confirming this load actually
				// went through) right after a real pulse - waiting for it
				// unconditionally would deadlock whenever nothing was
				// pending yet (e.g. at startup, before any order exists):
				// bottleAtPos1 would then never become present, since
				// nothing was ever loaded to cause it.
				await(bottleAtPos1);
			} else {
				if (!printedWaiting) {
					printedWaiting = true;
					System.out.printf("[Conveyor] auto-loader idle, nothing pending%n");
				}
				pause;
			}
		}
	}
	||
	{ // Left segment: Bottle Loader -> Pos 1
	  // loadBottle stands in for the Bottle Loader
	  // The belt starts moving by itself the moment a bottle is queued (no
	  // separate start button needed) provided the system is ready (enable),
	  // and the bottle is handed to the Rotary Table once it reaches Pos 1.
		while(true){
			await(loadBottle || autoLoadBottle);
			await(enable);
			// tells the GUI a bottle now starts travelling in from the loading
			// end - held for a bounded time rather than a single tick, since
			// this crosses the socket to the UI process and a bare one-tick
			// emit can race past the receiver's single-slot buffer (see
			// CLAUDE.md's cross-clock-domain signal reliability section)
			{
				long tEnter = System.currentTimeMillis();
				while (System.currentTimeMillis() - tEnter < 50) { emit bottleEnteredE; pause; }
			}

			// simulated travel time across the first quarter of the belt.
			// Each step is echoed to the GUI as leftMovingE so the on-screen
			// animation advances one discrete step per actual model tick,
			// instead of the canvas guessing a fixed real-time duration that
			// can drift out of sync with the model (see ConveyorCanvas).
			// Each step's emit is briefly held (instead of a single bare
			// tick) to survive the same socket race, but with a genuine
			// absent gap before the next step so ConveyorState.advanceLeftStep()
			// still only fires once per step (SimpleClient only sends on a
			// presence change, so a continuously-held signal across steps
			// would collapse into a single edge and make the bottle jump).
			// Each step's timer variable is uniquely named (tL1..tL8) since
			// this sjc build flattens block scopes within one thread, so
			// repeated declarations of the same name across steps collide.
			emit leftMoving; { long tL1 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL1 < 60) { emit leftMovingE; pause; } } pause;
			emit leftMoving; { long tL2 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL2 < 60) { emit leftMovingE; pause; } } pause;
			emit leftMoving; { long tL3 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL3 < 60) { emit leftMovingE; pause; } } pause;
			emit leftMoving; { long tL4 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL4 < 60) { emit leftMovingE; pause; } } pause;
			emit leftMoving; { long tL5 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL5 < 60) { emit leftMovingE; pause; } } pause;
			emit leftMoving; { long tL6 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL6 < 60) { emit leftMovingE; pause; } } pause;
			emit leftMoving; { long tL7 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL7 < 60) { emit leftMovingE; pause; } } pause;
			emit leftMoving; { long tL8 = System.currentTimeMillis(); while (System.currentTimeMillis() - tL8 < 60) { emit leftMovingE; pause; } } pause;

			// arrived at Pos 1 - hold the bottle here until the Rotary Table
			// has actually committed to taking it (pos1TakenAck), rather
			// than releasing after a fixed guess at how many ticks the
			// handoff "should" take. This is what keeps this plant and the
			// (independently-clocked) Rotary Table Controller correctly
			// synchronised at the handoff, regardless of either side's own
			// tick rate.
			abort(pos1TakenAck) {
				sustain bottleAtPos1;
			}

			// One more bottle now on the table, from this belt's point of
			// view - see TableOccupancy.
			{
				int onTable = TableOccupancy.increment();
				long tCount = System.currentTimeMillis();
				while (System.currentTimeMillis() - tCount < 100) { emit bottlesOnTableE(onTable); pause; }
			}
		}
	}
	||
	{ // Right segment: Rotary Table Pos 5 -> Collection point -> Labeller
	  // bottleFromTable is the real Rotary Table Pos 5 unload handoff,
	  // driven automatically by RotaryConveyorBridge (see
	  // rotaryTablePlant.sysj). Once handed over, the bottle travels to the
	  // end of the belt and is then handed on to the Labeller (see the
	  // collection-point handoff further down).
		while(true){
			await(bottleFromTable);
			await(enable);

			// One fewer bottle on the table now - see TableOccupancy.
			{
				int onTable = TableOccupancy.decrement();
				long tCount = System.currentTimeMillis();
				while (System.currentTimeMillis() - tCount < 100) { emit bottlesOnTableE(onTable); pause; }
			}

			// tells the GUI a bottle now starts travelling out from Pos 5 -
			// see the matching bottleEnteredE comment above for why this is
			// a bounded hold rather than a bare single-tick emit
			{
				long tReceived = System.currentTimeMillis();
				while (System.currentTimeMillis() - tReceived < 50) { emit bottleReceivedE; pause; }
			}

			// simulated travel time across the last quarter of the belt -
			// see the matching leftMovingE loop above for why each step is
			// a short bounded hold with a genuine absent gap after it, and
			// why each timer variable (tR1..tR8) needs a unique name
			emit rightMoving; { long tR1 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR1 < 60) { emit rightMovingE; pause; } } pause;
			emit rightMoving; { long tR2 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR2 < 60) { emit rightMovingE; pause; } } pause;
			emit rightMoving; { long tR3 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR3 < 60) { emit rightMovingE; pause; } } pause;
			emit rightMoving; { long tR4 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR4 < 60) { emit rightMovingE; pause; } } pause;
			emit rightMoving; { long tR5 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR5 < 60) { emit rightMovingE; pause; } } pause;
			emit rightMoving; { long tR6 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR6 < 60) { emit rightMovingE; pause; } } pause;
			emit rightMoving; { long tR7 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR7 < 60) { emit rightMovingE; pause; } } pause;
			emit rightMoving; { long tR8 = System.currentTimeMillis(); while (System.currentTimeMillis() - tR8 < 60) { emit rightMovingE; pause; } } pause;

			// arrived at the collection point - hand the bottle off to the
			// Labeller (enable/loadBottle stay as-is: legitimate stand-ins
			// for a Loader that doesn't exist yet).
			// Ack-or-timeout hold via ConveyorLabellerBridge (a single-segment
			// "run" package class, not a SignalLevelClient declared inline -
			// this build of sjc crashes resolving types from multi-segment
			// packages such as org.compsys704 when used for a local instance
			// declaration inside a .sysj reactive body). Bounded by a 30s
			// timeout (like the Rotary Table's Filler/Capper offers) rather
			// than an unbounded sustain/loop pair - without a timeout, a
			// Labeller that isn't running (or that stops acking) leaves this
			// plant permanently stuck here, unable to accept the next
			// bottle from Pos 1 either.
			abort(labellerTakenAck) {
				long tLabel = System.currentTimeMillis();
				while (System.currentTimeMillis() - tLabel < 30000) {
					emit bottleLeftPos5;
					ConveyorLabellerBridge.setBottleFromConveyor(true);
					pause;
				}
			}
			ConveyorLabellerBridge.setBottleFromConveyor(false);
			await(!labellerTakenAck);

			// Only now - genuinely ready for the next bottleFromTable, not
			// just having received this one - tell the Rotary Table it can
			// send its next bottle. Acking any earlier would let the Rotary
			// Table's next handoff race this segment's own still-running
			// travel/labeller sequence above (see CLAUDE.md).
			{
				long tAck = System.currentTimeMillis();
				while (System.currentTimeMillis() - tAck < 200) {
					RotaryConveyorBridge.setConveyorTakenAck(true);
					pause;
				}
			}
			RotaryConveyorBridge.setConveyorTakenAck(false);

			// Don't re-arm on the same still-true bottleFromTable: the Rotary
			// Table only clears it after it has itself seen conveyorTakenAck
			// (a genuine cross-process round trip via RotaryConveyorBridge),
			// so this loop can get back around to await(bottleFromTable)
			// above before that clear has actually propagated back - await
			// isn't edge-triggered, so without this it would immediately
			// re-fire on the same stale signal and process the same bottle
			// a second time, including a second, spurious
			// TableOccupancy.decrement() (visible as the "on table" count
			// drifting negative over several orders) - see CLAUDE.md.
			await(!bottleFromTable);
		}
	}
	||
	{ // Forward events to the GUI
		{while(true){present(bottleAtPos1){emit bottleAtPos1E;} pause;}}
		||
		{while(true){present(bottleLeftPos5){emit bottleLeftPos5E;} pause;}}
	}
}
