import run.RotaryTableGUI;
import run.RotaryConveyorBridge;
import run.RotaryCapperBridge;
import run.RotaryFillerBridge;
import run.RotaryLidBridge;
import run.RotaryTableState;

rotaryTablePlant(
		input signal rotaryTableTrigger;
		input signal start;
		input signal capperTakenAck;
		input signal fillerTakenAck;
		input signal lidPlacedAck;
		input signal conveyorTakenAck;
		output signal tableAlignedWithSensor, bottleAtPos5, capOnBottleAtPos1;
		output signal tableBusy, tableHasFreeSlot;
		output Integer signal bottleStage1E, bottleStage2E, bottleStage3E;
		output signal tableAlignedWithSensorE, bottleAtPos5E, capOnBottleAtPos1E, rotaryTableTriggerE;
		)
->
{
	new Thread(new RotaryTableGUI()).start();

	// One bottle can be assigned to each of these local signals at a time;
	// see RotaryTableState for how the dispatcher below picks a free lane
	// and why plain Java fields are safe for that (no real concurrency
	// within one clock domain - see CLAUDE.md).
	signal dispatchLane1, dispatchLane2, dispatchLane3;

	{ // table rotation / position sensor

		await(start);
		loop {
			// Wait for an actual request before responding, then respond for
			// as long as it's held - the previous version did this backwards
			// (abort(rotaryTableTrigger){sustain tableAlignedWithSensor;}
			// sustains tableAlignedWithSensor UNTIL triggered, not WHILE
			// triggered), so tableAlignedWithSensor was asserted continuously
			// from process startup, before any bottle had ever been
			// requested. Harmless for the old single-bottle pipeline (it
			// just treated whatever it saw first as "bottle 1" and moved on
			// once real bottles started arriving), but the multi-lane
			// dispatcher below reacts to every tick and was catching that
			// startup assertion as a real, distinct phantom bottle.
			await(rotaryTableTrigger);
			abort(!rotaryTableTrigger) {
				sustain tableAlignedWithSensor;
			}
			// simulated settle time for one 60-degree step
			pause; pause; pause;
		}
	}
	||
	{ // Tells the Controller whether it's worth offering a new bottle at
	  // all - see RotaryTableState.anyLaneIdle(). Replaces the old
	  // "tableBusy blocks everything until the whole cycle finishes" gate,
	  // which was the actual reason only one bottle could be on the table
	  // at once (see git history / CLAUDE.md before this change).
		while(true) {
			if (RotaryTableState.anyLaneIdle()) {
				emit tableHasFreeSlot;
			}
			pause;
		}
	}
	||
	{ // Dispatcher: claims each new-bottle pulse from the Controller for
	  // exactly one idle lane, then waits for the pulse to clear before
	  // watching for the next one - see RotaryTableState.
		loop {
			await(tableAlignedWithSensor);
			if (RotaryTableState.lane1Idle) {
				RotaryTableState.lane1Idle = false;
				emit dispatchLane1;
			} else if (RotaryTableState.lane2Idle) {
				RotaryTableState.lane2Idle = false;
				emit dispatchLane2;
			} else if (RotaryTableState.lane3Idle) {
				RotaryTableState.lane3Idle = false;
				emit dispatchLane3;
			}
			await(!tableAlignedWithSensor);
		}
	}
	||
	{ // Lane 1: one of three bottles that can be in flight on the table at
	  // once, each running the full Filler -> Lid Placer -> Capper ->
	  // Conveyor pipeline independently. Filler/Lid Placer/Capper/the
	  // Conveyor handoff are each a single physical station though, so a
	  // lane must claim the matching RotaryTableState lock before offering
	  // to one and release it right after - otherwise two lanes could both
	  // assert the same cross-domain "bottle ready" signal at once with no
	  // way to tell which bottle actually got served. Ack-or-timeout holds
	  // throughout, same shape as the original single-bottle version this
	  // replaced - see CLAUDE.md.
		final long STAGE_VIEW_DELAY_MS = 400;
		loop {
			await(dispatchLane1);
			// Set once this bottle is abandoned at any station (unfilled, no
			// lid, or uncapped) - carried to the Conveyor/Labeller/Sorter at
			// the exit handoff below so the Sorter can reject it for a real
			// reason instead of a coin flip.
			boolean defective = false;
			System.out.printf("[RT] lane1: bottle assigned, offering to Filler%n");

			while (!RotaryTableState.tryClaimFiller()) { pause; }
			// A previous lane's fillerTakenAck can still be lingering
			// present the instant this lane claims the lock - entering
			// abort(fillerTakenAck) then would tear down after one tick
			// without a real fill (see CLAUDE.md's abort entry-precondition
			// pitfall).
			await(!fillerTakenAck);
			long tFillStart = System.currentTimeMillis();
			abort(fillerTakenAck) {
				long t2 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t2 < 30000) {
					RotaryFillerBridge.setBottleReadyForFiller(true);
					emit tableBusy;
					emit bottleStage1E(2);
					pause;
				}
			}
			RotaryFillerBridge.setBottleReadyForFiller(false);
			present(fillerTakenAck) {
				System.out.printf("[RT] lane1: fillerTakenAck received after %dms%n", System.currentTimeMillis() - tFillStart);
			} else {
				System.out.printf("[RT] lane1: TIMED OUT waiting for fillerTakenAck after %dms - moving on unfilled%n", System.currentTimeMillis() - tFillStart);
				defective = true;
			}
			RotaryTableState.releaseFiller();

			{
				long tGap1 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap1 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage1E(2);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimLid()) { pause; }
			await(!lidPlacedAck);
			System.out.printf("[RT] lane1: offering to Lid Placer%n");
			long tLidStart = System.currentTimeMillis();
			abort(lidPlacedAck) {
				long t5 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t5 < 15000) {
					RotaryLidBridge.setRequest(true);
					long sinceStart = System.currentTimeMillis() - t5;
					boolean enableFlag = (sinceStart % 200) < 100;
					RotaryLidBridge.setEnable(enableFlag);
					emit tableBusy;
					emit bottleStage1E(4);
					pause;
				}
			}
			RotaryLidBridge.setRequest(false);
			RotaryLidBridge.setEnable(false);
			present(lidPlacedAck) {
				System.out.printf("[RT] lane1: lidPlacedAck received after %dms%n", System.currentTimeMillis() - tLidStart);
			} else {
				System.out.printf("[RT] lane1: TIMED OUT waiting for lidPlacedAck after %dms - moving on without a lid%n", System.currentTimeMillis() - tLidStart);
				defective = true;
			}
			RotaryTableState.releaseLid();

			{
				long tGap2 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap2 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage1E(4);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimCapper()) { pause; }
			await(!capperTakenAck);
			System.out.printf("[RT] lane1: offering to Capper%n");
			long tCapStart = System.currentTimeMillis();
			abort(capperTakenAck) {
				long t0 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t0 < 10000) {
					RotaryCapperBridge.setBottleAtPos4(true);
					emit tableBusy;
					emit bottleStage1E(1);
					pause;
				}
			}
			RotaryCapperBridge.setBottleAtPos4(false);
			present(capperTakenAck) {
				System.out.printf("[RT] lane1: capperTakenAck received after %dms%n", System.currentTimeMillis() - tCapStart);
				long t1 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t1 < 200) {
					emit capOnBottleAtPos1;
					emit tableBusy;
					emit bottleStage1E(1);
					pause;
				}
			} else {
				System.out.printf("[RT] lane1: TIMED OUT waiting for capperTakenAck after %dms - moving on uncapped%n", System.currentTimeMillis() - tCapStart);
				defective = true;
			}
			RotaryTableState.releaseCapper();

			{
				long tGap3 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap3 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage1E(1);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimConveyorExit()) { pause; }
			await(!conveyorTakenAck);
			System.out.printf("[RT] lane1: handing off to Conveyor at Pos 5%n");
			long tExitStart = System.currentTimeMillis();
			abort(conveyorTakenAck) {
				long t3 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t3 < 35000) {
					emit bottleAtPos5;
					emit tableBusy;
					emit bottleStage1E(3);
					RotaryConveyorBridge.setBottleFromTable(true);
					RotaryConveyorBridge.setBottleDefectiveFromTable(defective);
					pause;
				}
			}
			RotaryConveyorBridge.setBottleFromTable(false);
			RotaryConveyorBridge.setBottleDefectiveFromTable(false);
			present(conveyorTakenAck) {
				System.out.printf("[RT] lane1: conveyorTakenAck received after %dms%n", System.currentTimeMillis() - tExitStart);
			} else {
				System.out.printf("[RT] lane1: TIMED OUT waiting for conveyorTakenAck after %dms%n", System.currentTimeMillis() - tExitStart);
			}
			RotaryTableState.releaseConveyorExit();

			{
				long t4 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t4 < 200) {
					emit bottleStage1E(0);
					pause;
				}
			}
			System.out.printf("[RT] lane1: bottle cycle complete, %dms total%n", System.currentTimeMillis() - tFillStart);

			RotaryTableState.lane1Idle = true;
		}
	}
	||
	{ // Lane 2 - identical to Lane 1, see its comments.
		final long STAGE_VIEW_DELAY_MS = 400;
		loop {
			await(dispatchLane2);
			boolean defective = false;
			System.out.printf("[RT] lane2: bottle assigned, offering to Filler%n");

			while (!RotaryTableState.tryClaimFiller()) { pause; }
			// A previous lane's fillerTakenAck can still be lingering
			// present the instant this lane claims the lock - entering
			// abort(fillerTakenAck) then would tear down after one tick
			// without a real fill (see CLAUDE.md's abort entry-precondition
			// pitfall).
			await(!fillerTakenAck);
			long tFillStart = System.currentTimeMillis();
			abort(fillerTakenAck) {
				long t2 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t2 < 30000) {
					RotaryFillerBridge.setBottleReadyForFiller(true);
					emit tableBusy;
					emit bottleStage2E(2);
					pause;
				}
			}
			RotaryFillerBridge.setBottleReadyForFiller(false);
			present(fillerTakenAck) {
				System.out.printf("[RT] lane2: fillerTakenAck received after %dms%n", System.currentTimeMillis() - tFillStart);
			} else {
				System.out.printf("[RT] lane2: TIMED OUT waiting for fillerTakenAck after %dms - moving on unfilled%n", System.currentTimeMillis() - tFillStart);
				defective = true;
			}
			RotaryTableState.releaseFiller();

			{
				long tGap1 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap1 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage2E(2);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimLid()) { pause; }
			await(!lidPlacedAck);
			System.out.printf("[RT] lane2: offering to Lid Placer%n");
			long tLidStart = System.currentTimeMillis();
			abort(lidPlacedAck) {
				long t5 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t5 < 15000) {
					RotaryLidBridge.setRequest(true);
					long sinceStart = System.currentTimeMillis() - t5;
					boolean enableFlag = (sinceStart % 200) < 100;
					RotaryLidBridge.setEnable(enableFlag);
					emit tableBusy;
					emit bottleStage2E(4);
					pause;
				}
			}
			RotaryLidBridge.setRequest(false);
			RotaryLidBridge.setEnable(false);
			present(lidPlacedAck) {
				System.out.printf("[RT] lane2: lidPlacedAck received after %dms%n", System.currentTimeMillis() - tLidStart);
			} else {
				System.out.printf("[RT] lane2: TIMED OUT waiting for lidPlacedAck after %dms - moving on without a lid%n", System.currentTimeMillis() - tLidStart);
				defective = true;
			}
			RotaryTableState.releaseLid();

			{
				long tGap2 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap2 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage2E(4);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimCapper()) { pause; }
			await(!capperTakenAck);
			System.out.printf("[RT] lane2: offering to Capper%n");
			long tCapStart = System.currentTimeMillis();
			abort(capperTakenAck) {
				long t0 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t0 < 10000) {
					RotaryCapperBridge.setBottleAtPos4(true);
					emit tableBusy;
					emit bottleStage2E(1);
					pause;
				}
			}
			RotaryCapperBridge.setBottleAtPos4(false);
			present(capperTakenAck) {
				System.out.printf("[RT] lane2: capperTakenAck received after %dms%n", System.currentTimeMillis() - tCapStart);
				long t1 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t1 < 200) {
					emit capOnBottleAtPos1;
					emit tableBusy;
					emit bottleStage2E(1);
					pause;
				}
			} else {
				System.out.printf("[RT] lane2: TIMED OUT waiting for capperTakenAck after %dms - moving on uncapped%n", System.currentTimeMillis() - tCapStart);
				defective = true;
			}
			RotaryTableState.releaseCapper();

			{
				long tGap3 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap3 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage2E(1);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimConveyorExit()) { pause; }
			await(!conveyorTakenAck);
			System.out.printf("[RT] lane2: handing off to Conveyor at Pos 5%n");
			long tExitStart = System.currentTimeMillis();
			abort(conveyorTakenAck) {
				long t3 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t3 < 35000) {
					emit bottleAtPos5;
					emit tableBusy;
					emit bottleStage2E(3);
					RotaryConveyorBridge.setBottleFromTable(true);
					RotaryConveyorBridge.setBottleDefectiveFromTable(defective);
					pause;
				}
			}
			RotaryConveyorBridge.setBottleFromTable(false);
			RotaryConveyorBridge.setBottleDefectiveFromTable(false);
			present(conveyorTakenAck) {
				System.out.printf("[RT] lane2: conveyorTakenAck received after %dms%n", System.currentTimeMillis() - tExitStart);
			} else {
				System.out.printf("[RT] lane2: TIMED OUT waiting for conveyorTakenAck after %dms%n", System.currentTimeMillis() - tExitStart);
			}
			RotaryTableState.releaseConveyorExit();

			{
				long t4 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t4 < 200) {
					emit bottleStage2E(0);
					pause;
				}
			}
			System.out.printf("[RT] lane2: bottle cycle complete, %dms total%n", System.currentTimeMillis() - tFillStart);

			RotaryTableState.lane2Idle = true;
		}
	}
	||
	{ // Lane 3 - identical to Lane 1, see its comments.
		final long STAGE_VIEW_DELAY_MS = 400;
		loop {
			await(dispatchLane3);
			boolean defective = false;
			System.out.printf("[RT] lane3: bottle assigned, offering to Filler%n");

			while (!RotaryTableState.tryClaimFiller()) { pause; }
			// A previous lane's fillerTakenAck can still be lingering
			// present the instant this lane claims the lock - entering
			// abort(fillerTakenAck) then would tear down after one tick
			// without a real fill (see CLAUDE.md's abort entry-precondition
			// pitfall).
			await(!fillerTakenAck);
			long tFillStart = System.currentTimeMillis();
			abort(fillerTakenAck) {
				long t2 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t2 < 30000) {
					RotaryFillerBridge.setBottleReadyForFiller(true);
					emit tableBusy;
					emit bottleStage3E(2);
					pause;
				}
			}
			RotaryFillerBridge.setBottleReadyForFiller(false);
			present(fillerTakenAck) {
				System.out.printf("[RT] lane3: fillerTakenAck received after %dms%n", System.currentTimeMillis() - tFillStart);
			} else {
				System.out.printf("[RT] lane3: TIMED OUT waiting for fillerTakenAck after %dms - moving on unfilled%n", System.currentTimeMillis() - tFillStart);
				defective = true;
			}
			RotaryTableState.releaseFiller();

			{
				long tGap1 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap1 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage3E(2);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimLid()) { pause; }
			await(!lidPlacedAck);
			System.out.printf("[RT] lane3: offering to Lid Placer%n");
			long tLidStart = System.currentTimeMillis();
			abort(lidPlacedAck) {
				long t5 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t5 < 15000) {
					RotaryLidBridge.setRequest(true);
					long sinceStart = System.currentTimeMillis() - t5;
					boolean enableFlag = (sinceStart % 200) < 100;
					RotaryLidBridge.setEnable(enableFlag);
					emit tableBusy;
					emit bottleStage3E(4);
					pause;
				}
			}
			RotaryLidBridge.setRequest(false);
			RotaryLidBridge.setEnable(false);
			present(lidPlacedAck) {
				System.out.printf("[RT] lane3: lidPlacedAck received after %dms%n", System.currentTimeMillis() - tLidStart);
			} else {
				System.out.printf("[RT] lane3: TIMED OUT waiting for lidPlacedAck after %dms - moving on without a lid%n", System.currentTimeMillis() - tLidStart);
				defective = true;
			}
			RotaryTableState.releaseLid();

			{
				long tGap2 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap2 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage3E(4);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimCapper()) { pause; }
			await(!capperTakenAck);
			System.out.printf("[RT] lane3: offering to Capper%n");
			long tCapStart = System.currentTimeMillis();
			abort(capperTakenAck) {
				long t0 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t0 < 10000) {
					RotaryCapperBridge.setBottleAtPos4(true);
					emit tableBusy;
					emit bottleStage3E(1);
					pause;
				}
			}
			RotaryCapperBridge.setBottleAtPos4(false);
			present(capperTakenAck) {
				System.out.printf("[RT] lane3: capperTakenAck received after %dms%n", System.currentTimeMillis() - tCapStart);
				long t1 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t1 < 200) {
					emit capOnBottleAtPos1;
					emit tableBusy;
					emit bottleStage3E(1);
					pause;
				}
			} else {
				System.out.printf("[RT] lane3: TIMED OUT waiting for capperTakenAck after %dms - moving on uncapped%n", System.currentTimeMillis() - tCapStart);
				defective = true;
			}
			RotaryTableState.releaseCapper();

			{
				long tGap3 = System.currentTimeMillis();
				while (System.currentTimeMillis() - tGap3 < STAGE_VIEW_DELAY_MS) {
					emit tableBusy;
					emit bottleStage3E(1);
					pause;
				}
			}

			while (!RotaryTableState.tryClaimConveyorExit()) { pause; }
			await(!conveyorTakenAck);
			System.out.printf("[RT] lane3: handing off to Conveyor at Pos 5%n");
			long tExitStart = System.currentTimeMillis();
			abort(conveyorTakenAck) {
				long t3 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t3 < 35000) {
					emit bottleAtPos5;
					emit tableBusy;
					emit bottleStage3E(3);
					RotaryConveyorBridge.setBottleFromTable(true);
					RotaryConveyorBridge.setBottleDefectiveFromTable(defective);
					pause;
				}
			}
			RotaryConveyorBridge.setBottleFromTable(false);
			RotaryConveyorBridge.setBottleDefectiveFromTable(false);
			present(conveyorTakenAck) {
				System.out.printf("[RT] lane3: conveyorTakenAck received after %dms%n", System.currentTimeMillis() - tExitStart);
			} else {
				System.out.printf("[RT] lane3: TIMED OUT waiting for conveyorTakenAck after %dms%n", System.currentTimeMillis() - tExitStart);
			}
			RotaryTableState.releaseConveyorExit();

			{
				long t4 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t4 < 200) {
					emit bottleStage3E(0);
					pause;
				}
			}
			System.out.printf("[RT] lane3: bottle cycle complete, %dms total%n", System.currentTimeMillis() - tFillStart);

			RotaryTableState.lane3Idle = true;
		}
	}
	||
	{ // Forward events to the GUI for the animated turntable render.
		{while(true){present(tableAlignedWithSensor){emit tableAlignedWithSensorE;} pause;}}
		||
		{while(true){present(bottleAtPos5){emit bottleAtPos5E;} pause;}}
		||
		{while(true){present(capOnBottleAtPos1){emit capOnBottleAtPos1E;} pause;}}
		||
		{while(true){present(rotaryTableTrigger){emit rotaryTableTriggerE;} pause;}}
	}
}
