import run.RotaryTableGUI;
import run.RotaryConveyorBridge;
import run.RotaryCapperBridge;
import run.RotaryFillerBridge;
import run.RotaryLidBridge;
import run.RotaryIndexState;
import digitaltwin.TwinClient;

rotaryTablePlant(
		input signal rotaryTableTrigger;
		input signal start;
		input signal capperTakenAck;
		input signal fillerTakenAck;
		input signal lidPlacedAck;
		input signal conveyorTakenAck;
		input signal fillerFaulted, lidFaulted, capperFaulted;
		output signal tableAlignedWithSensor, bottleAtPos5;
		output signal tableBusy, tableHasFreeSlot;
		output Integer signal slot0BottleIdE, slot1BottleIdE, slot2BottleIdE, slot3BottleIdE, slot4BottleIdE;
		output signal tableAlignedWithSensorE, bottleAtPos5E, rotaryTableTriggerE;

		// Same events as the *E signals above, mirrored to a second socket for the
		// Big-Picture view (a different process from the Rotary Table's own GUI, so it
		// needs its own copy - SystemJ codegen is 1-signal-name-to-1-socket).
		output Integer signal slot0BottleIdBigE, slot1BottleIdBigE, slot2BottleIdBigE, slot3BottleIdBigE, slot4BottleIdBigE;
		output signal tableAlignedWithSensorBigE, bottleAtPos5BigE, rotaryTableTriggerBigE;
		)
->
{
	new Thread(new RotaryTableGUI()).start();

	// True synchronized indexing: 5 fixed physical slots (0=Entry/Pos1, 1=Filler/Pos2, 2=Lid Placer/Pos3, 3=Capper/Pos4, 4=Exit/Pos5) advance together atomically - no claim/release locks needed since indexing guarantees one bottle per slot.

	{ // Table rotation / position sensor + entry request handling.
	  // Must await(rotaryTableTrigger) then abort(!rotaryTableTrigger) - the reverse order asserts "aligned" from process startup.
	  // Loading Pos 1 is a stationary conveyor push, same as unloading Pos 5 - it does NOT wait for a rotation, only the shared Index coordinator does; conflating the two starves the table of throughput.
		await(start);
		loop {
			await(rotaryTableTrigger);
			while (!RotaryIndexState.isEntryFree()) { pause; }
			RotaryIndexState.loadEntry();
			abort(!rotaryTableTrigger) {
				sustain tableAlignedWithSensor;
			}
		}
	}
	||
	{ // Tells the Controller whether it's worth offering a new bottle at all.
		while(true) {
			if (RotaryIndexState.isEntryFree()) {
				emit tableHasFreeSlot;
			}
			pause;
		}
	}
	||
	{ // Index coordinator: advances the whole table one slot atomically once the Exit slot is clear and every occupied working slot is done for this dwell period.
	  // Also the sole source of ROTARY_TURN reports to the digital twin - exactly one call per genuine
	  // index step, not per Entry-load event and not per waiting-tick (the old call site in
	  // rotaryTableController.sysj fired on every tick of its alignment-wait loop and relied on
	  // SystemTwin's 500ms debounce to collapse that back to one - which silently ate any second
	  // real rotation landing within 500ms of the last, permanently desyncing every active bottle's
	  // tracked position one step behind. Now there's nothing to debounce: one doIndex() = one call.
		TwinClient twin = new TwinClient("rotary-table-plant", "127.0.0.1", 9090);
		loop {
			if (RotaryIndexState.canIndex()) {
				RotaryIndexState.doIndex();
				System.out.printf("[RT] INDEX: table advanced one slot%n");
				twin.reportRotaryTurn();
			}
			pause;
		}
	}
	||
	{ // Slot 1 (Filler): offers whatever bottle is currently dwelling here to
	  // the Filler, ack-or-timeout, then marks done and waits for the next
	  // index event to move this bottle on before offering again.
		loop {
			while (!RotaryIndexState.isOccupied(1)) { pause; }
			int myId = RotaryIndexState.getBottleId(1);
			System.out.printf("[RT] slot1 (Filler): offering bottle #%d%n", myId);

			// await(!fillerTakenAck) first - a previous bottle's ack could still be present, and abort() checks its condition at entry.
			await(!fillerTakenAck);
			long tFillStart = System.currentTimeMillis();
			abort(fillerTakenAck) {
				long t2 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t2 < 16000) {
					RotaryFillerBridge.setBottleReadyForFiller(true);
					emit tableBusy;
					pause;
				}
			}
			RotaryFillerBridge.setBottleReadyForFiller(false);
			present(fillerTakenAck) {
				System.out.printf("[RT] slot1: fillerTakenAck received after %dms%n", System.currentTimeMillis() - tFillStart);
				present(fillerFaulted) {
					System.out.printf("[RT] slot1: bottle #%d faulted at the Filler - marking defective%n", myId);
					RotaryIndexState.markDefective(1);
				}
			} else {
				System.out.printf("[RT] slot1: TIMED OUT waiting for fillerTakenAck after %dms - moving on unfilled%n", System.currentTimeMillis() - tFillStart);
				RotaryIndexState.markDefective(1);
			}
			RotaryIndexState.markDone(1);

			while (RotaryIndexState.getBottleId(1) == myId) { pause; }
		}
	}
	||
	{ // Slot 2 (Lid Placer): same shape as slot 1.
		loop {
			while (!RotaryIndexState.isOccupied(2)) { pause; }
			int myId = RotaryIndexState.getBottleId(2);
			System.out.printf("[RT] slot2 (Lid Placer): offering bottle #%d%n", myId);

			await(!lidPlacedAck);
			long tLidStart = System.currentTimeMillis();
			abort(lidPlacedAck) {
				long t5 = System.currentTimeMillis();
				// Must exceed the Lid Placer's own worst-case fault detection (3 attempts x 3000ms, plus the 1200ms visible-empty pause and refill/backup-mode overhead) or the table gives up before the controller ever faults.
				while (System.currentTimeMillis() - t5 < 14000) {
					RotaryLidBridge.setRequest(true);
					long sinceStart = System.currentTimeMillis() - t5;
					// Slower duty cycle than other stations so the arm's motion reads as a deliberate placement rather than a blur.
					boolean enableFlag = (sinceStart % 260) < 130;
					RotaryLidBridge.setEnable(enableFlag);
					emit tableBusy;
					pause;
				}
			}
			RotaryLidBridge.setRequest(false);
			RotaryLidBridge.setEnable(false);
			present(lidPlacedAck) {
				System.out.printf("[RT] slot2: lidPlacedAck received after %dms%n", System.currentTimeMillis() - tLidStart);
				present(lidFaulted) {
					System.out.printf("[RT] slot2: bottle #%d faulted at the Lid Placer - marking defective%n", myId);
					RotaryIndexState.markDefective(2);
				}
			} else {
				System.out.printf("[RT] slot2: TIMED OUT waiting for lidPlacedAck after %dms - moving on without a lid%n", System.currentTimeMillis() - tLidStart);
				RotaryIndexState.markDefective(2);
			}
			RotaryIndexState.markDone(2);

			while (RotaryIndexState.getBottleId(2) == myId) { pause; }
		}
	}
	||
	{ // Slot 3 (Capper): same shape as slot 1/2.
		loop {
			while (!RotaryIndexState.isOccupied(3)) { pause; }
			int myId = RotaryIndexState.getBottleId(3);
			System.out.printf("[RT] slot3 (Capper): offering bottle #%d%n", myId);

			boolean myDefective = RotaryIndexState.isDefective(3);
			await(!capperTakenAck);
			long tCapStart = System.currentTimeMillis();
			abort(capperTakenAck) {
				long t0 = System.currentTimeMillis();
				// Must exceed the Capper's own worst-case fault detection (a single 8000ms stall check, plus backup-mode overhead) or the table gives up before the controller ever faults.
				while (System.currentTimeMillis() - t0 < 11000) {
					RotaryCapperBridge.setBottleAtPos4(true);
					// Tells the Controller up front this bottle was already abandoned upstream (e.g. no lid) so it can refuse to cap it instead of wasting a cap.
					RotaryCapperBridge.setBottleDefectiveAtPos4(myDefective);
					emit tableBusy;
					pause;
				}
			}
			RotaryCapperBridge.setBottleAtPos4(false);
			RotaryCapperBridge.setBottleDefectiveAtPos4(false);
			present(capperTakenAck) {
				System.out.printf("[RT] slot3: capperTakenAck received after %dms%n", System.currentTimeMillis() - tCapStart);
				present(capperFaulted) {
					System.out.printf("[RT] slot3: bottle #%d faulted at the Capper - marking defective%n", myId);
					RotaryIndexState.markDefective(3);
				}
			} else {
				System.out.printf("[RT] slot3: TIMED OUT waiting for capperTakenAck after %dms - moving on uncapped%n", System.currentTimeMillis() - tCapStart);
				RotaryIndexState.markDefective(3);
			}
			RotaryIndexState.markDone(3);

			while (RotaryIndexState.getBottleId(3) == myId) { pause; }
		}
	}
	||
	{ // Slot 4 (Exit): hands the dwelling bottle off to the Conveyor at
	  // Pos 5, ack-or-timeout, then clears the slot either way so the table
	  // can never deadlock waiting on a Conveyor that never acks.
		loop {
			while (!RotaryIndexState.isOccupied(4)) { pause; }
			int myId = RotaryIndexState.getBottleId(4);
			boolean defective = RotaryIndexState.isDefective(4);
			System.out.printf("[RT] slot4 (Exit): handing off bottle #%d to Conveyor%n", myId);

			await(!conveyorTakenAck);
			long tExitStart = System.currentTimeMillis();
			abort(conveyorTakenAck) {
				long t3 = System.currentTimeMillis();
				while (System.currentTimeMillis() - t3 < 18000) {
					emit bottleAtPos5;
					emit tableBusy;
					RotaryConveyorBridge.setBottleFromTable(true);
					RotaryConveyorBridge.setBottleDefectiveFromTable(defective);
					pause;
				}
			}
			RotaryConveyorBridge.setBottleFromTable(false);
			RotaryConveyorBridge.setBottleDefectiveFromTable(false);
			present(conveyorTakenAck) {
				System.out.printf("[RT] slot4: conveyorTakenAck received after %dms%n", System.currentTimeMillis() - tExitStart);
			} else {
				System.out.printf("[RT] slot4: TIMED OUT waiting for conveyorTakenAck after %dms%n", System.currentTimeMillis() - tExitStart);
			}
			RotaryIndexState.takeExit();
		}
	}
	||
	{ // Viz mirrors: forward each slot's bottle id to the UI on change, widened-held briefly for reliable delivery across the socket hop to the UI SignalServer.
		int lastSeen0 = -1;
		loop {
			if (RotaryIndexState.getBottleId(0) != lastSeen0) {
				int v = RotaryIndexState.getBottleId(0);
				lastSeen0 = v;
				long tMirror = System.currentTimeMillis();
				while (System.currentTimeMillis() - tMirror < 150) {
					emit slot0BottleIdE(v);
					pause;
				}
			}
			pause;
		}
	}
	||
	{
		int lastSeen1 = -1;
		loop {
			if (RotaryIndexState.getBottleId(1) != lastSeen1) {
				int v = RotaryIndexState.getBottleId(1);
				lastSeen1 = v;
				long tMirror = System.currentTimeMillis();
				while (System.currentTimeMillis() - tMirror < 150) {
					emit slot1BottleIdE(v);
					pause;
				}
			}
			pause;
		}
	}
	||
	{
		int lastSeen2 = -1;
		loop {
			if (RotaryIndexState.getBottleId(2) != lastSeen2) {
				int v = RotaryIndexState.getBottleId(2);
				lastSeen2 = v;
				long tMirror = System.currentTimeMillis();
				while (System.currentTimeMillis() - tMirror < 150) {
					emit slot2BottleIdE(v);
					pause;
				}
			}
			pause;
		}
	}
	||
	{
		int lastSeen3 = -1;
		loop {
			if (RotaryIndexState.getBottleId(3) != lastSeen3) {
				int v = RotaryIndexState.getBottleId(3);
				lastSeen3 = v;
				long tMirror = System.currentTimeMillis();
				while (System.currentTimeMillis() - tMirror < 150) {
					emit slot3BottleIdE(v);
					pause;
				}
			}
			pause;
		}
	}
	||
	{
		int lastSeen4 = -1;
		loop {
			if (RotaryIndexState.getBottleId(4) != lastSeen4) {
				int v = RotaryIndexState.getBottleId(4);
				lastSeen4 = v;
				long tMirror = System.currentTimeMillis();
				while (System.currentTimeMillis() - tMirror < 150) {
					emit slot4BottleIdE(v);
					pause;
				}
			}
			pause;
		}
	}
	||
	{ // Forward events to the GUI for the animated turntable render.
		{while(true){present(tableAlignedWithSensor){emit tableAlignedWithSensorE;} pause;}}
		||
		{while(true){present(bottleAtPos5){emit bottleAtPos5E;} pause;}}
		||
		{while(true){present(rotaryTableTrigger){emit rotaryTableTriggerE;} pause;}}
	}
	||
	{ // Same events mirrored to the Big-Picture socket - read back off the *E
	  // signals themselves (already the ground truth relayed to the Rotary
	  // Table's own GUI above) rather than duplicating every emit site.
		{while(true){present(tableAlignedWithSensorE){emit tableAlignedWithSensorBigE;} pause;}}
		||
		{while(true){present(bottleAtPos5E){emit bottleAtPos5BigE;} pause;}}
		||
		{while(true){present(rotaryTableTriggerE){emit rotaryTableTriggerBigE;} pause;}}
		||
		{while(true){present(slot0BottleIdE){emit slot0BottleIdBigE((Integer)#slot0BottleIdE);} pause;}}
		||
		{while(true){present(slot1BottleIdE){emit slot1BottleIdBigE((Integer)#slot1BottleIdE);} pause;}}
		||
		{while(true){present(slot2BottleIdE){emit slot2BottleIdBigE((Integer)#slot2BottleIdE);} pause;}}
		||
		{while(true){present(slot3BottleIdE){emit slot3BottleIdBigE((Integer)#slot3BottleIdE);} pause;}}
		||
		{while(true){present(slot4BottleIdE){emit slot4BottleIdBigE((Integer)#slot4BottleIdE);} pause;}}
	}
}
