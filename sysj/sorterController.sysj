import digitaltwin.TwinClient;
import run.LabellerSorterBridge;

SorterController(
    input signal bottleAtSorter;
    input signal bottleDefective;
    input signal pusherExtended;
    input signal pusherRetracted;

    output signal extendPusher;
    output signal sortedE;
    output signal rejectedE;
    output signal sortedOkE;											
    output signal sortRejectedE;										
)
->
{
    // Rename to twin_init for the top-level scope to avoid shadowing issues
    TwinClient twin_init = new TwinClient("sorter", "127.0.0.1", 9090);
    System.out.println("SorterController: Initialized and running.");
    twin_init.update(digitaltwin.PlantTwin.State.IDLE);
    signal twinFault;

    loop {
        System.out.println("SorterController: Waiting for bottle at sorter...");
        await (bottleAtSorter);

        {
            long tAck = System.currentTimeMillis();
            while (System.currentTimeMillis() - tAck < 200) {
                LabellerSorterBridge.setSorterTakenAck(true);
                pause;
            }
            LabellerSorterBridge.setSorterTakenAck(false);
        }

        { // Branch 1: Main Inspection and Sorting logic
            // Re-declare local variables inside the parallel branch so SystemJ can resolve them
            TwinClient twin = new TwinClient("sorter", "127.0.0.1", 9090);
            String productId = twin.getProductIdAtPosition(5);  
            if (productId == null || productId.isEmpty()) {
                productId = "UNKNOWN";
            }

            System.out.println("SorterController: Bottle (" + productId + ") detected. Inspecting...");
            
            // Fully qualify PlantTwin to bypass SystemJ's inner-class import bugs
            twin.update(digitaltwin.PlantTwin.State.IN_PROGRESS);
            
            {
                long tInspect = System.currentTimeMillis();
                while (System.currentTimeMillis() - tInspect < 600) { pause; }
            }

            present (bottleDefective || twinFault) {
                System.out.println("SorterController: Defect detected - diverting bottle.");

                await (!pusherExtended);
                abort (pusherExtended) {
                    sustain extendPusher;
                }
                System.out.println("SorterController: Pusher confirmed extended. Holding to divert...");

                long t0 = System.currentTimeMillis();
                while (System.currentTimeMillis() - t0 < 300) {
                    emit extendPusher;
                    emit rejectedE;
                    emit sortRejectedE;
                    pause;
                }

                twin.recordEvent("Rejected", productId);
                twin.archiveProduct(productId, true);

                System.out.println("SorterController: Releasing pusher.");
                await (!bottleAtSorter);
            } else {
                System.out.println("SorterController: Bottle OK - passing through.");

                long t0 = System.currentTimeMillis();
                while (System.currentTimeMillis() - t0 < 300) {
                    emit sortedE;
                    emit sortedOkE;
                    pause;
                }

                twin.recordEvent("Sorted OK", productId);
                twin.archiveProduct(productId, false);

                await (!bottleAtSorter);
                System.out.println("SorterController: Cycle complete. Returning to idle.");
                twin.update(digitaltwin.PlantTwin.State.IDLE);
            }
        }
        ||
        { // Branch 2: Fault checking logic
            // Re-declare local variables inside the parallel branch so SystemJ can resolve them
            TwinClient twin = new TwinClient("sorter", "127.0.0.1", 9090);
            String productId = twin.getProductIdAtPosition(5);  
            if (productId == null || productId.isEmpty()) {
                productId = "UNKNOWN";
            }
            
            boolean upstreamFault = twin.hasFault(productId);
            
            if (upstreamFault) {
                abort (!bottleAtSorter) {
                    sustain twinFault;
                }
            }
        }
    }       
}