<System xmlns="http://systemjtechnology.com">
      <SubSystem Name="SS1" Local="true">
              <ClockDomain Name="CapperControllerCD" Class="CapperController">
                      <!-- Input Signals mapped to a Server receiver -->
                      <iSignal Name="bottleAtPos4"      Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="gripperMaxLower"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="gripperMaxLift"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="capGripped"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="gripperInitPos"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="gripperFullTwist"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="clearCapperFaultM" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="mode"                    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="sendGripperDownM"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="sendGripperTwistM"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="sendGripperUntwistM"     Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="sendGripCapM"            Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />
                      <iSignal Name="sendClampM"              Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10010" />


                      <!-- Output Signals mapped to a Client transmitter (assumed targeting CapperPlantCD) -->
                      <oSignal Name="sendGripperDown"    To="CapperPlantCD.sendGripperDown"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10011" />
                      <oSignal Name="sendGripperTwist"   To="CapperPlantCD.sendGripperTwist"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10011" />
                      <oSignal Name="sendGripperUntwist" To="CapperPlantCD.sendGripperUntwist" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10011" />
                      <oSignal Name="sendGripCap"        To="CapperPlantCD.sendGripCap"        Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10011" />
                      <oSignal Name="sendClamp"          To="CapperPlantCD.sendClamp"          Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10011" />

                      <oSignal Name="capperFaultE"       To="UI.capperFaultE"                  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
                      <oSignal Name="capperBackupE"      To="UI.capperBackupE"                 Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10012" />
                      <oSignal Name="capperFaultBigE"    To="BigPicture.capperFaultBigE"       Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20012" />
                      <oSignal Name="capperBackupBigE"   To="BigPicture.capperBackupBigE"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="20012" />
                      <oSignal Name="capperFaultOut"     To="CoordinatorCD.capperFaultOut"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10004" />
              </ClockDomain>
      </SubSystem>
</System>