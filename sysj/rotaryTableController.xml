<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS1" Local="true">
		<ClockDomain Name="rotaryTableControllerCD" Class="rotaryTableController">
			<iSignal Name="tableAlignedWithSensor" 	Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10000" />
			<iSignal Name="bottleAtPos5"  			Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10000" />
			<iSignal Name="capOnBottleAtPos1"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10000" />
			<iSignal Name="readyToRotate"    		Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10000" />

			<oSignal Name="rotaryTableTrigger" To="PlantCD.pusherExtend" 	Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10001" />
			<oSignal Name="tableRotationComplete"        To="PlantCD.vacOn" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10001" />

			<iSignal Name="mode"	Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10000" />
			<iSignal Name="rotateM"	Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10000" />
		</ClockDomain>
	</SubSystem>
</System>
