<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS3" Local="true">
		<ClockDomain Name="RotaryTableControllerCD" Class="rotaryTableController">
			<iSignal Name="tableAlignedWithSensor" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10016" />
			<iSignal Name="bottleAtPos5"           Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10016" />
			<iSignal Name="tableBusy"              Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10016" />
			<iSignal Name="tableHasFreeSlot"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10016" />
			<iSignal Name="readyToRotate"          Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10016" />

			<oSignal Name="rotaryTableTrigger"    To="RotaryTablePlantCD.rotaryTableTrigger" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10017" />

			<!-- mode / rotateM come straight from the GUI, same pattern as
			     "mode" / "pusherExtendM" going straight to ControllerCD
			     in the Lab 3 Workpiece Loader example, rather than via the Plant. -->
			<iSignal Name="mode"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10016" />
			<iSignal Name="rotateM" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10016" />
		</ClockDomain>
	</SubSystem>
</System>
