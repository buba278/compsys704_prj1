import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;
import run.RotaryCapperBridge;
import run.CapperFaultState;
CapperController(
    input signal bottleAtPos4;
    input signal bottleDefectiveAtPos4;							// RotaryTablePlant -> capperController (bottle already abandoned upstream, e.g. no lid - refuse to cap it)
    input signal gripperMaxLower;
    input signal gripperMaxLift;
    input signal capGripped;
    input signal gripperInitPos;
    input signal gripperFullTwist;
    input signal clearCapperFaultM;								// GUI -> capperController (operator clears an active fault)
    input Integer signal mode;
    input signal sendGripperDownM, sendGripperTwistM, sendGripperUntwistM, sendGripCapM, sendClampM;

    output signal sendGripperDown;
    output signal sendGripperTwist;
    output signal sendGripperUntwist;
    output signal sendGripCap;
    output signal sendClamp;
    output signal capperFaultE;									// capperController -> UI viz (fault indicator)
    output signal capperFaultOut;								// capperController -> coordinator (station faulted)
    output signal capperBackupE;								// capperController -> UI viz (persistent backup-unit-active indicator)
    output signal capperFaultBigE, capperBackupBigE;			// capperController -> BigPicture viz (separate socket from the station's own GUI)
)
->
{
	// Bridges CapperFaultState into signals the capping thread can abort on.
	signal stationFault, attemptTimedOut;
	signal auto, manual;
	{
		int modeVal = 0;
		loop {
			present (mode) {
				modeVal = (Integer)#mode;
			}
			if (modeVal == 1) {
				emit manual;
			}
			else {
				emit auto;
			}
			pause;
		}
	}
	||
	{
	TwinClient twin = new TwinClient("cap-screwer", "127.0.0.1", 9090);

    System.out.println("CapperController: Initialized and running.");
    twin.update(PlantTwin.State.IDLE);

    loop {
    abort (manual) {
    // Nest in its own loop so it keeps handling bottles in auto mode without needing a manual-mode round trip to re-arm.
    loop {

        System.out.println("CapperController: Waiting for bottle at Position 4...");
        await (bottleAtPos4);
        String productId = twin.getProductIdAtPosition(3);

        present (bottleDefectiveAtPos4) {
            // Bottle was already abandoned upstream (e.g. the Lid Placer's magazine ran empty) - capping it
            // would just waste a cap on a bottle the Sorter is going to reject anyway. Skip it outright: no
            // physical attempt, and deliberately no fault indication of any kind on the Capper's side (no
            // ERROR state, no backup-mode lamp, no stationFault/capperFaultOut) - the Capper didn't malfunction,
            // the Lid Placer already raised (and owns) the one fault for this bottle. Straight back to waiting
            // for the next bottle - nothing here needs a manual Clear Fault.
            System.out.println("CapperController: Bottle detected but missing a lid - skipping, bottle already faulted upstream.");
            twin.recordEvent("Capping skipped (no lid - upstream fault)", productId);

            {
                long tAck = System.currentTimeMillis();
                while (System.currentTimeMillis() - tAck < 100) {
                    RotaryCapperBridge.setCapperTakenAck(true);
                    pause;
                }
                RotaryCapperBridge.setCapperTakenAck(false);
            }

            System.out.println("CapperController: Cycle complete.");
            twin.update(PlantTwin.State.IDLE);
        } else {
        System.out.println("CapperController: Bottle detected. Starting capping sequence.");
        twin.update(PlantTwin.State.IN_PROGRESS);

        // A stall is a motor fault, not a knocked-loose cap - retrying gains nothing since the same
        // physical cause will just stall again identically every time, so this is a single attempt.
        System.out.println("CapperController: capping attempt started.");
        CapperFaultState.beginAttempt();
        abort(gripperFullTwist || stationFault || attemptTimedOut) {
            {
                sustain sendClamp;
            }
            ||
            {
                System.out.println("CapperController: Lowering gripper...");
                sustain sendGripperDown;
            }
            ||
            {
                await(gripperMaxLower);
                System.out.println("CapperController: Gripper reached lowest position. Gripping cap...");
                sustain sendGripCap;
            }
            ||
            {
                await(capGripped);
                System.out.println("CapperController: Cap secured. Twisting gripper...");
                // Hold the signal every tick, not a single-tick emit, since the Plant's independent clock could miss a one-tick pulse.
                loop {
                    emit sendGripperTwist;
                    pause;
                }
            }
        }
        CapperFaultState.endAttempt();
        boolean twistOk;
        present (gripperFullTwist) {
            twistOk = true;
        } else {
            twistOk = false;
            present (stationFault) {
                System.out.println("CapperController: fault manually triggered (or already raised) mid-attempt.");
            } else {
                System.out.println("CapperController: stall detected - full twist never achieved.");
            }
        }
        if (twistOk) {
            System.out.println("CapperController: Gripper full twist achieved. Releasing clamp & resetting.");
            twin.recordEvent("Cap screwed on", productId);
        } else {
            if (!CapperFaultState.isStationFaulted()) {
                CapperFaultState.raiseStationFault();
            }
            System.out.println("CapperController: FAULT - capping failed, bottle abandoned");
            twin.update(PlantTwin.State.ERROR);
            twin.recordEvent("Capping aborted (fault)", productId);
            // Backup unit takes over automatically for future bottles; hold stationFault just long enough for escalation/lamp below to see it.
            System.out.println("CapperController: station faulted - switching to backup unit for future bottles");
            CapperFaultState.enterBackupMode();
            {
                long tBackup = System.currentTimeMillis();
                while (System.currentTimeMillis() - tBackup < 250) { pause; }
            }
            CapperFaultState.clearStationFault();
        }

     	// Tell the Rotary Table this station is done (capped or faulted); widened hold since this crosses the socket to RotaryTablePlantCD.
     	{
     		long tAck = System.currentTimeMillis();
     		while (System.currentTimeMillis() - tAck < 100) {
     			RotaryCapperBridge.setCapperTakenAck(true);
     			RotaryCapperBridge.setCapperFaulted(!twistOk);
     			pause;
     		}
     		RotaryCapperBridge.setCapperTakenAck(false);
     		RotaryCapperBridge.setCapperFaulted(false);
     	}

        // Return the gripper to a safe/init position regardless of outcome.
        abort(gripperInitPos) {
        {
            sustain sendClamp;
           }
            ||
            {
                System.out.println("CapperController: Untwisting gripper to initial position...");
                // FIX: same one-shot-pulse issue as sendGripperTwist above.
                loop {
                    emit sendGripperUntwist;
                    pause;
                }
            }
        }
        System.out.println("CapperController: Gripper returned to initial position.");
        System.out.println("CapperController: Cycle complete.");
        twin.update(PlantTwin.State.IDLE);
        }
    }
    }
    await (manual);
    System.out.println("CapperController: Manual mode");
    abort (auto) {
        while (true) {
            present (sendGripperDownM) {
                emit sendGripperDown;
            }
            present (sendGripperTwistM) {
                emit sendGripperTwist;
            }
            present (sendGripperUntwistM) {
                emit sendGripperUntwist;
            }
            present (sendGripCapM) {
                emit sendGripCap;
            }
            present (sendClampM) {
                emit sendClamp;
            }
            pause;
        }
    }
    await (auto);
    }
	}
	||
	{
	// Bridges CapperFaultState into stationFault/attemptTimedOut signals and latches the GUI's Clear Fault button.
	loop {
		present (clearCapperFaultM) {
			CapperFaultState.clearStationFault();
			// Operator has physically swapped the backup unit back to
			// primary - return to normal fault detection.
			CapperFaultState.exitBackupMode();
		}
		if (CapperFaultState.isStationFaulted()) {
			emit stationFault;
			emit capperFaultE;
			emit capperFaultBigE;
		}
		if (CapperFaultState.isAttemptTimedOut(8000)) {
			emit attemptTimedOut;
		}
		if (CapperFaultState.isUsingBackup()) {
			emit capperBackupE;
			emit capperBackupBigE;
		}
		pause;
	}
}
||
{
	// Escalates a station fault to the Coordinator; await(!stationFault) at the end stops this re-firing every hold expiry while the fault persists.
	loop {
		await (stationFault);
		System.out.printf("CapperController: capperFaultOut -> coordinator (holding)%n");
		abort (!bottleAtPos4) {
			long tFault = System.currentTimeMillis();
			while (System.currentTimeMillis() - tFault < 200) {
				emit capperFaultOut;
				pause;
			}
		}
		await (!stationFault);
	}
	}
}