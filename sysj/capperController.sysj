import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;
import run.RotaryCapperBridge;
import run.CapperFaultState;
CapperController(
    input signal bottleAtPos4;
    input signal gripperMaxLower;
    input signal gripperMaxLift;
    input signal capGripped;
    input signal gripperInitPos;
    input signal gripperFullTwist;
    input signal clearCapperFaultM;								// GUI -> capperController (operator clears an active fault)

    output signal sendGripperDown;
    output signal sendGripperTwist;
    output signal sendGripperUntwist;
    output signal sendGripCap;
    output signal sendClamp;
    output signal capperFaultE;									// capperController -> UI viz (fault indicator)
    output signal capperFaultOut;								// capperController -> coordinator (station faulted)
)
->
{
	// Bridges CapperFaultState.stationFaulted into a signal the capping
	// thread can abort on, and attemptTimedOut into a per-attempt-timeout
	// signal - see CLAUDE.md for the Filler's identical fault architecture,
	// which this mirrors. Unlike the Filler's continuous stall condition,
	// a knocked-loose cap is a discrete failure a retry can recover from,
	// so a single attempt timing out only fails THAT attempt, not the
	// whole station - see run.CapperFaultState and the IP report.
	signal stationFault, attemptTimedOut;
	{
	signal twistSucceeded, retriesExhausted;
	TwinClient twin = new TwinClient("cap-screwer", "127.0.0.1", 9090);

    System.out.println("CapperController: Initialized and running.");
    twin.update(PlantTwin.State.IDLE);

    loop {

        System.out.println("CapperController: Waiting for bottle at Position 4...");
        await (bottleAtPos4);
        String productId = twin.getProductIdAtPosition(4);
        System.out.println("CapperController: Bottle detected. Starting capping sequence.");
        twin.update(PlantTwin.State.IN_PROGRESS);

        // Retries up to 3 times, driven by an abort() around a native loop
        // rather than a Java while() - sjc's JavaPrettyPrinter crashes with
        // "TerminateNode can have only one child" when a present/else whose
        // branches both pause() sits directly inside a while() loop, even
        // with nothing else nearby; wrapping the retry in abort(signal){
        // loop{...} } instead (the same idiom the rest of this codebase
        // already uses for bounded reactive work) avoids it entirely -
        // confirmed by bisecting a minimal reproduction against this sjc
        // build.
        int attempt = 0;
        abort (twistSucceeded || retriesExhausted) {
            loop {
                attempt = attempt + 1;
                System.out.printf("CapperController: capping attempt %d/3%n", attempt);
                CapperFaultState.beginAttempt();
                abort(gripperFullTwist || stationFault || attemptTimedOut) {
                    {
                        sustain sendClamp;
                    }
                    ||
                    {
                        System.out.println("CapperController: Lowering gripper...");
                        sustain sendGripperDown;
                    }
                    ||
                    {
                        await(gripperMaxLower);
                        System.out.println("CapperController: Gripper reached lowest position. Gripping cap...");
                        sustain sendGripCap;
                    }
                    ||
                    {
                        await(capGripped);
                        System.out.println("CapperController: Cap secured. Twisting gripper...");
                        // FIX: was `emit sendGripperTwist; pause;` - a single-tick pulse that the
                        // Plant's independently-clocked Rotation branch could miss entirely (GALS
                        // domains aren't guaranteed to sample on the same tick). Keep asserting it
                        // every tick; the enclosing abort above still terminates this loop the
                        // instant the Plant acknowledges, or the timeout/fault fires.
                        loop {
                            emit sendGripperTwist;
                            pause;
                        }
                    }
                }
                CapperFaultState.endAttempt();
                present (gripperFullTwist) {
                    emit twistSucceeded;
                } else {
                present (stationFault) {
                    // Manually triggered (or already raised) mid-attempt -
                    // stop retrying and go straight to the fault path below.
                    emit retriesExhausted;
                } else {
                    if (attempt >= 3) {
                        System.out.printf("CapperController: attempt %d timed out, giving up%n", attempt);
                        emit retriesExhausted;
                    } else {
                        System.out.printf("CapperController: attempt %d timed out, retrying%n", attempt);
                        abort(gripperInitPos) {
                            sustain sendGripperUntwist;
                        }
                    }
                }
                }
                pause;
            }
        }
        boolean twistOk;
        present (twistSucceeded) {
            twistOk = true;
        } else {
            twistOk = false;
        }
        if (twistOk) {
            System.out.println("CapperController: Gripper full twist achieved. Releasing clamp & resetting.");
            twin.recordEvent("Cap screwed on", productId);
        } else {
            if (!CapperFaultState.isStationFaulted()) {
                CapperFaultState.raiseStationFault();
            }
            System.out.printf("CapperController: FAULT - capping failed after %d attempts, bottle abandoned%n", attempt);
            twin.update(PlantTwin.State.ERROR);
            twin.recordEvent("Capping aborted (fault)", productId);
            // Waited for here rather than after the safe-state reset below -
            // sjc's JavaPrettyPrinter throws "TerminateNode can have only one
            // child" when a bounded while/pause loop (or abort) sits directly
            // between an await(...) and a following if statement, same as
            // the identical issue documented in coordinator.sysj.
            System.out.println("CapperController: awaiting fault clear before returning to rotation");
            await (!stationFault);
            System.out.println("CapperController: fault cleared, resuming");
        }

     	// Tell the Rotary Table this station is done with the bottle
     	// (whether capped or faulted) so it can move on to Pos 1 - same
     	// abandon-and-continue philosophy as the Filler, see CLAUDE.md.
     	// Ack-or-timeout hold, not a bare single-tick emit, since this
     	// crosses the socket to RotaryTablePlantCD and repeats once per
     	// bottle.
     	{
     		long tAck = System.currentTimeMillis();
     		while (System.currentTimeMillis() - tAck < 200) {
     			RotaryCapperBridge.setCapperTakenAck(true);
     			pause;
     		}
     		RotaryCapperBridge.setCapperTakenAck(false);
     	}

        // Return the gripper to a safe/init position regardless of outcome.
        abort(gripperInitPos) {
        {
            sustain sendClamp;
           }
            ||
            {
                System.out.println("CapperController: Untwisting gripper to initial position...");
                // FIX: same one-shot-pulse issue as sendGripperTwist above.
                loop {
                    emit sendGripperUntwist;
                    pause;
                }
            }
        }
        System.out.println("CapperController: Gripper returned to initial position.");
        System.out.println("CapperController: Cycle complete.");
        twin.update(PlantTwin.State.IDLE);
    }
	}
	||
	{
	// Bridges CapperFaultState into stationFault/attemptTimedOut and
	// latches the GUI's Clear Fault button - mirrors the Filler's identical
	// bridging thread. No direct "trigger fault" signal here (unlike an
	// earlier version) - matching the Filler, the only way to demonstrate a
	// fault is to simulate the real physical cause ("Jam Twist" on the
	// Plant side, see capperPlant.sysj) so this controller's own retry/
	// timeout detection is what actually raises it, not the GUI faking the
	// end state.
	loop {
		present (clearCapperFaultM) {
			CapperFaultState.clearStationFault();
		}
		if (CapperFaultState.isStationFaulted()) {
			emit stationFault;
			emit capperFaultE;
		}
		if (CapperFaultState.isAttemptTimedOut(8000)) {
			emit attemptTimedOut;
		}
		pause;
	}
}
||
{
	// Escalates a station fault to the Coordinator. The await(!stationFault)
	// at the end matters: stationFault stays present for the whole fault,
	// and await isn't edge-triggered, so without it this would restart
	// every time the hold below expires for as long as the fault lasts -
	// see CLAUDE.md.
	loop {
		await (stationFault);
		System.out.printf("CapperController: capperFaultOut -> coordinator (holding)%n");
		abort (!bottleAtPos4) {
			long tFault = System.currentTimeMillis();
			while (System.currentTimeMillis() - tFault < 200) {
				emit capperFaultOut;
				pause;
			}
		}
		await (!stationFault);
	}
	}
}