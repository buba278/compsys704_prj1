import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;
import run.RotaryFillerBridge;
import run.CoordinatorBatchState;
Coordinator(
    input signal orderReady;                                    // POS -> coordinator
    input Integer signal orderLiquidARatio, orderTargetVolume, orderQuantity;
    input signal fillDoneE;                                     // filler -> coordinator (repointed)
    input signal fillReady;                                     // filler confirms reset, ready for next bottle
    input signal fillFaultOut;                                  // filler -> coordinator (station faulted, stop presenting this bottle)
    input signal sortedOkE, sortRejectedE;                      // sorter -> coordinator (per-bottle outcome; drives batch completion and replacement bottles)
    input signal bottleReadyForFiller;                          // rotary table -> coordinator (real bottle handoff)
    input signal capperFaultOut;                                // capper -> coordinator (station faulted, logged only - no redundant line yet)
    input signal lidFaultOut;                                   // lid placer -> coordinator (station faulted, logged only - no redundant line yet)

    output Integer signal liquidARatio, targetVolumeMl;         // coordinator -> fillerController
    output signal bottleAtPos2;                                 // coordinator -> fillerController
    output signal bottleAtPos2P;                                // coordinator -> fillerPlant (same event, 2nd socket)
    output Integer signal bottlesNeeded;                        // coordinator -> conveyorPlant (auto-loads one bottle per unit ordered)
    output Integer signal liquidARatioL, targetVolumeMlL;       // coordinator -> labellerPlant (same recipe, 3rd socket, so the label matches what's actually in the bottle)
    output Integer signal liquidARatioC;                        // coordinator -> conveyorPlant (same recipe, 4th socket, so the exiting bottle's colour split matches what's actually in it)

    output Integer signal batchDone;                            // coordinator -> POS (carries elapsed ms)

    output Integer signal liquidARatioE, targetVolumeMlE, bottlesNeededE; // coordinator -> BigPicture viz (active recipe)
    output Integer signal bottlesFilledE;                       // coordinator -> BigPicture viz (progress within current batch)
    output signal bottleFaultedE;                               // coordinator -> BigPicture viz (last attempt faulted)
    output signal batchDoneE;                                   // coordinator -> BigPicture viz
    output Integer signal batchElapsedE;                        // coordinator -> BigPicture viz (mirrors batchDone's payload)
)
->
{
	// An order is only complete once `quantity` bottles have actually been
	// sorted OK - a reject doesn't count toward it and queues a replacement
	// instead (see run.CoordinatorBatchState and the sort-outcome thread
	// below). The counters live in that plain Java class rather than as
	// SystemJ local variables shared across these `||` threads - a local
	// variable declared before a `||` split is NOT actually shared, sjc
	// generates a separate per-thread copy of it (confirmed by a compile
	// failure referencing it from a sibling thread), so cross-thread state
	// within one domain has to go through a Java class instead, same as
	// RotaryTableState/FillerFaultState/CapperFaultState (safe because
	// SystemJ threads within one clock domain run cooperatively, one at a
	// time per reaction, not as real concurrent OS threads - see CLAUDE.md).
	signal orderSatisfied; // level-asserted once goodSorted >= this order's quantity

	{
	TwinClient twin = new TwinClient("coordinator", "127.0.0.1", 9090);
    loop {
        System.out.printf("[Coordinator] waiting for orderLiquidARatio%n");
        await (orderLiquidARatio);
        int ratioA = (Integer)#orderLiquidARatio;
        System.out.printf("[Coordinator] got ratioA=%d, waiting for orderTargetVolume%n", ratioA);
        await (orderTargetVolume);
        int volume = (Integer)#orderTargetVolume;
        System.out.printf("[Coordinator] got volume=%d, waiting for orderQuantity%n", volume);
        await (orderQuantity);
        int quantity = (Integer)#orderQuantity;
        System.out.printf("[Coordinator] got quantity=%d, waiting for orderReady%n", quantity);
        await (orderReady);
        System.out.printf("[Coordinator] order ratioA=%d vol=%d qty=%d%n", ratioA, volume, quantity);
		
        long tRecipe = System.currentTimeMillis();
        twin.startBatch(quantity);
        // Timer for the widened hold below starts only now, after the twin
        // call has already returned - startBatch() can block for a while
        // establishing (or failing to establish) its socket to the twin
        // server, and starting the clock before that call silently ate the
        // whole hold window before the loop's first condition check ever
        // ran true, so bottlesNeeded (and the other recipe signals) never
        // actually got emitted at all.
        int filled = 0;
        long tEmit = System.currentTimeMillis();
        while (System.currentTimeMillis() - tEmit < 300) {
            emit liquidARatio(ratioA);
            emit targetVolumeMl(volume);
            emit bottlesNeeded(quantity);
            emit liquidARatioL(ratioA);
            emit targetVolumeMlL(volume);
            emit liquidARatioC(ratioA);
            emit liquidARatioE(ratioA);
            emit targetVolumeMlE(volume);
            emit bottlesNeededE(quantity);
            emit bottlesFilledE(filled);
            pause;
        }

        long start = System.currentTimeMillis();
        CoordinatorBatchState.startOrder(quantity);
        int attempt = 0;

        // Driven by abort(orderSatisfied){ loop{...} } rather than a Java
        // while() - sjc's JavaPrettyPrinter crashes with "TerminateNode can
        // have only one child" when a present/else whose branches both
        // pause() sits directly inside a while() loop, even with nothing
        // else nearby (confirmed by bisecting a minimal reproduction - see
        // the identical workaround in capperController.sysj/controller.sysj
        // and the CLAUDE.md entry on it). goodSorted and neededTotal are
        // updated by the sorter-outcome thread below as bottles actually
        // reach the sorter, arbitrarily long after they're started here, so
        // this loop just keeps starting bottles up to whatever neededTotal
        // currently is and otherwise waits - a reject bumping neededTotal
        // mid-flight is picked up on this same loop's next tick.
        abort (orderSatisfied) {
            loop {
                if (CoordinatorBatchState.getStarted() < CoordinatorBatchState.getNeededTotal()) {
                    int startedNow = CoordinatorBatchState.incrementStarted();
                    attempt = attempt + 1;
                    boolean bottleFaulted = false;
                    System.out.printf("[Coordinator] awaiting a real bottle handoff from the Rotary Table, attempt %d%n", attempt);
                    await (bottleReadyForFiller);
                    System.out.printf("[Coordinator] abort-block start, attempt %d (started %d/%d, %d/%d sorted good)%n", attempt, startedNow, CoordinatorBatchState.getNeededTotal(), CoordinatorBatchState.getGoodSorted(), quantity);
                    abort (fillDoneE || fillFaultOut) {
                        loop {
                            emit bottleAtPos2;
                            emit bottleAtPos2P;
                            pause;
                        }
                    }
                    present (fillFaultOut) {
                        bottleFaulted = true;
                        System.out.printf("[Coordinator] fillFaultOut received on attempt %d - station faulted, replacement queued%n", attempt);
                    } else {
                        System.out.printf("[Coordinator] fillDoneE fired on attempt %d, awaiting fillReady%n", attempt);
                    }
                    if (!bottleFaulted) {
                        filled = filled + 1;
                    }
                    // Tell the Rotary Table this bottle's filling stage is done (whether
                    // filled or faulted) so it can hand the bottle on to Pos 5. Ack-or-
                    // timeout hold, not a bare single-tick emit, since this crosses the
                    // socket to RotaryTablePlantCD and repeats once per bottle - see
                    // CLAUDE.md. Also carries this bottle's outcome to the BigPicture
                    // viz (bottleFaultedE/bottlesFilledE) on the same hold, rather than
                    // a separate ack loop, to avoid double-acking fillerTakenAck.
                    long tFillerAck = System.currentTimeMillis();
                    while (System.currentTimeMillis() - tFillerAck < 200) {
                        RotaryFillerBridge.setFillerTakenAck(true);
                        if (bottleFaulted) {
                            emit bottleFaultedE;
                        } else {
                            emit bottlesFilledE(filled);
                        }
                        pause;
                    }
                    RotaryFillerBridge.setFillerTakenAck(false);
                    await (fillReady);
                    if (bottleFaulted) {
                        // Abandoned at the Filler - it will never reach the
                        // sorter, so it can never emit sortedOkE/sortRejectedE.
                        // Count it as needing a replacement right away, same
                        // as a real sorter rejection.
                        int nowNeeded = CoordinatorBatchState.addNeeded(1);
                        System.out.printf("[Coordinator] attempt %d abandoned due to fault, queuing a replacement (now need %d total)%n", attempt, nowNeeded);
                    } else {
                        System.out.printf("[Coordinator] bottle from attempt %d filled, travelling to sorting%n", attempt);
                    }
                } else if (CoordinatorBatchState.getGoodSorted() >= quantity) {
                    emit orderSatisfied;
                }
                pause;
            }
        }
        
        

        int elapsed = (int)(System.currentTimeMillis() - start);
        twin.reportBatchDone(elapsed);
        long tBatch = System.currentTimeMillis();
        while (System.currentTimeMillis() - tBatch < 50) {
            emit batchDone(elapsed);
            emit batchDoneE;
            emit batchElapsedE(elapsed);
            pause;
        }
        System.out.printf("[Coordinator] batch complete in %d ms - %d/%d sorted good, %d attempts total%n", elapsed, CoordinatorBatchState.getGoodSorted(), quantity, attempt);
    }
}
||
{
	// Tracks sorter outcomes: goodSorted counts bottles that satisfy the
	// order, while a reject bumps neededTotal so the production loop above
	// sends a replacement. Both signals are widened holds from a different
	// clock domain (see CLAUDE.md), so edge-guarded here - without that, a
	// single reject/sort event held present for its whole hold window would
	// be double (or triple) counted.
	TwinClient twin = new TwinClient("coordinator", "127.0.0.1", 9090);
	boolean sawSortedOk = false;
	boolean sawSortRejected = false;
	loop {
		present (sortedOkE) {
			if (!sawSortedOk) {
				sawSortedOk = true;
				int nowGood = CoordinatorBatchState.incrementGoodSorted();
				System.out.printf("[Coordinator] sortedOkE received - %d sorted good so far%n", nowGood);
				twin.reportProgress(nowGood);
			}
		} else {
			sawSortedOk = false;
		}
		present (sortRejectedE) {
			if (!sawSortRejected) {
				sawSortRejected = true;
				int nowNeeded = CoordinatorBatchState.addNeeded(1);
				System.out.printf("[Coordinator] sortRejectedE received - queuing a replacement (now need %d total)%n", nowNeeded);
			}
		} else {
			sawSortRejected = false;
		}
		pause;
	}
}
||
{
	// Logs Lid Placer / Capper faults as they're escalated. No redundant
	// duplicate line exists yet (see the IP report, section 6 - out of
	// scope for now), so there's no rerouting decision to make here; this
	// just makes a faulted station visible at the Coordinator's own log
	// rather than only at that station's own GUI. await(!cond) at the end
	// of each loop matters: both fault signals stay present for the whole
	// fault, and await isn't edge-triggered, so without it this would
	// reprint every tick for as long as the fault lasts - see CLAUDE.md.
	loop {
		await (capperFaultOut);
		System.out.printf("[Coordinator] capperFaultOut received - Capper is faulted, awaiting recovery%n");
		await (!capperFaultOut);
	}
}
||
{
	loop {
		await (lidFaultOut);
		System.out.printf("[Coordinator] lidFaultOut received - Lid Placer is faulted, awaiting recovery%n");
		await (!lidFaultOut);
	}
	}
}
