        int attempt = 0;
        while (filled < quantity) {
            attempt = attempt + 1;
            boolean bottleFaulted = false;
            System.out.printf("[Coordinator] awaiting a real bottle handoff from the Rotary Table, attempt %d%n", attempt);
            await (bottleReadyForFiller);
            System.out.printf("[Coordinator] abort-block start, attempt %d (bottle %d/%d)%n", attempt, filled + 1, quantity);
            abort (fillDoneE || fillFaultOut) {
                loop {
                    emit bottleAtPos2;
                    emit bottleAtPos2P;
                    pause;
                }
            }
            present (fillFaultOut) {
                bottleFaulted = true;
                System.out.printf("[Coordinator] fillFaultOut received on attempt %d - station faulted, awaiting recovery%n", attempt);
            } else {
                System.out.printf("[Coordinator] fillDoneE fired on attempt %d, awaiting fillReady%n", attempt);
            }
            // Tell the Rotary Table this bottle's filling stage is done (whether
            // filled or faulted) so it can hand the bottle on to Pos 5. Ack-or-
            // timeout hold, not a bare single-tick emit, since this crosses the
            // socket to RotaryTablePlantCD and repeats once per bottle - see
            // CLAUDE.md. Placed here (right after the outcome is known) rather
            // than after await(fillReady) below - sjc's JavaPrettyPrinter
            // throws "TerminateNode can have only one child" when a bounded
            // while/pause loop sits directly between an await(...) and a
            // following if statement; this position also makes more semantic
            // sense, since fillReady is about the Filler being ready for the
            // *next* bottle, not about *this* bottle being finished.
            long tFillerAck = System.currentTimeMillis();
            while (System.currentTimeMillis() - tFillerAck < 200) {
                RotaryFillerBridge.setFillerTakenAck(true);
                pause;
            }
            RotaryFillerBridge.setFillerTakenAck(false);
            await (fillReady);
            if (!bottleFaulted) {
                filled = filled + 1;
                twin.reportProgress(filled);
                System.out.printf("[Coordinator] bottle %d/%d done%n", filled, quantity);
            } else {
                // Not counted toward the batch, since there's no redundant line to reroute to
                // yet. This retries with a fresh bottle at the same, now-recovered station.
                System.out.printf("[Coordinator] attempt %d abandoned due to fault, retrying (not counted toward batch)%n", attempt);
            }
        }

        int elapsed = (int)(System.currentTimeMillis() - start);
        twin.reportBatchElapsed(elapsed);
        long tBatch = System.currentTimeMillis();
        while (System.currentTimeMillis() - tBatch < 50) {
            emit batchDone(elapsed);
            pause;
        }
        System.out.printf("[Coordinator] batch complete in %d ms%n", elapsed);
    }
}
