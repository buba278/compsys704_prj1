Coordinator(
    input signal orderReady;                                    // POS -> coordinator
    input Integer signal orderLiquidARatio, orderTargetVolume, orderQuantity;
    input signal fillDoneE;                                     // filler -> coordinator (repointed)
    input signal fillReady;                                     // filler confirms reset, ready for next bottle
    input signal fillFaultOut;                                  // filler -> coordinator (station faulted, stop presenting this bottle)

    output Integer signal liquidARatio, targetVolumeMl;         // coordinator -> fillerController
    output signal bottleAtPos2;                                 // coordinator -> fillerController
    output signal bottleAtPos2P;                                // coordinator -> fillerPlant (same event, 2nd socket)

    output Integer signal batchDone;                            // coordinator -> POS (carries elapsed ms)
)
->
{
    loop {
        System.out.printf("[Coordinator] waiting for orderLiquidARatio%n");
        await (orderLiquidARatio);
        int ratioA = (Integer)#orderLiquidARatio;
        System.out.printf("[Coordinator] got ratioA=%d, waiting for orderTargetVolume%n", ratioA);
        await (orderTargetVolume);
        int volume = (Integer)#orderTargetVolume;
        System.out.printf("[Coordinator] got volume=%d, waiting for orderQuantity%n", volume);
        await (orderQuantity);
        int quantity = (Integer)#orderQuantity;
        System.out.printf("[Coordinator] got quantity=%d, waiting for orderReady%n", quantity);
        await (orderReady);
        System.out.printf("[Coordinator] order ratioA=%d vol=%d qty=%d%n", ratioA, volume, quantity);

        long tRecipe = System.currentTimeMillis();
        while (System.currentTimeMillis() - tRecipe < 50) {
            emit liquidARatio(ratioA);
            emit targetVolumeMl(volume);
            pause;
        }

        long start = System.currentTimeMillis();
        int filled = 0;
        int attempt = 0;
        while (filled < quantity) {
            attempt = attempt + 1;
            boolean bottleFaulted = false;
            System.out.printf("[Coordinator] abort-block start, attempt %d (bottle %d/%d)%n", attempt, filled + 1, quantity);
            abort (fillDoneE || fillFaultOut) {
                loop {
                    emit bottleAtPos2;
                    emit bottleAtPos2P;
                    pause;
                }
            }
            present (fillFaultOut) {
                bottleFaulted = true;
                System.out.printf("[Coordinator] fillFaultOut received on attempt %d - station faulted, awaiting recovery%n", attempt);
            } else {
                System.out.printf("[Coordinator] fillDoneE fired on attempt %d, awaiting fillReady%n", attempt);
            }
            await (fillReady);
            if (!bottleFaulted) {
                filled = filled + 1;
                System.out.printf("[Coordinator] bottle %d/%d done%n", filled, quantity);
            } else {
                // Not counted toward the batch, since there's no redundant line to reroute to
                // yet. This retries with a fresh bottle at the same, now-recovered station.
                System.out.printf("[Coordinator] attempt %d abandoned due to fault, retrying (not counted toward batch)%n", attempt);
            }
        }

        int elapsed = (int)(System.currentTimeMillis() - start);
        long tBatch = System.currentTimeMillis();
        while (System.currentTimeMillis() - tBatch < 50) {
            emit batchDone(elapsed);
            pause;
        }
        System.out.printf("[Coordinator] batch complete in %d ms%n", elapsed);
    }
}
