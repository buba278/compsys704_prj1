import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;
import run.RotaryLidBridge;
import run.LidFaultState;
import run.LoaderRefillBridge;

Controller(
		input signal pusherRetracted,pusherExtended,WPgripped,armAtSource,armAtDest,empty,request;
		output signal pusherExtend,vacOn,armSource,armDest;
		input Integer signal mode;
		input signal pusherExtendM,vacOnM,armSourceM,armDestM;
		input signal clearLidFaultM;								// GUI -> controller (operator clears an active fault)
		output signal lidFaultE;									// controller -> UI viz (fault indicator)
		output signal lidFaultOut;									// controller -> coordinator (station faulted)
		output signal lidBackupE;									// controller -> UI viz (persistent backup-unit-active indicator)
		)
->{

	signal auto, manual;
	// Bridges LidFaultState into signals the placement thread can abort on (mirrors CapperController's fault architecture).
	signal stationFault, attemptTimedOut;

	{
		int modeVal = 0;
		loop {
			present (mode) {
				modeVal = (Integer)#mode;
			}
			if (modeVal == 1) {
				emit manual;
			}
			else {
				emit auto;
			}
			pause;
		}
	}
	||
	{
		TwinClient twin = new TwinClient("lid-placer", "127.0.0.1", 9090);
		twin.update(PlantTwin.State.IDLE);
		System.out.printf("main loop entered%n");
		loop {
			abort (manual) {
				// Nest in its own loop so it keeps handling bottles in auto mode without needing a manual-mode round trip to re-arm.
				loop {
					System.out.printf("Auto: %d%n", 1);
					twin.update(PlantTwin.State.IDLE);
					// 1. The arm swivels to the position extended if a new workpiece is requested (request).
					await (request);
					System.out.printf("request received%n");
					twin.update(PlantTwin.State.IN_PROGRESS);
					abort (armAtDest) {
						sustain armDest;
					}
					// 2. The pusher extends and pushes a workpiece out of the magazine.

					abort (pusherExtended) {
						sustain pusherExtend;
					}
					// 3. The pusher retracts back once it is fully extended.
					await (pusherRetracted);
					// 4. The arm swivels back to the position retracted
					abort (armAtSource) {
						sustain armSource;
					}

					// 5 & 6. Vacuum on, hold until gripped, arm to destination; retried up to 3 times since a lid can be knocked loose mid-grip.
					// Retry via abort(signal){ loop{...} }, not a Java while() - sjc crashes on present/else-with-pause inside a while().
					int attempt = 0;
					signal placeSucceeded, retriesExhausted;
					abort (placeSucceeded || retriesExhausted) {
						loop {
							attempt = attempt + 1;
							System.out.printf("lid grip attempt %d/3%n", attempt);
							LidFaultState.beginAttempt();
							abort ((WPgripped && armAtDest) || stationFault || attemptTimedOut || empty) {
								{sustain vacOn;}
								||
								{sustain armDest;}
							}
							LidFaultState.endAttempt();
							present (WPgripped && armAtDest) {
								emit placeSucceeded;
							} else {
							present (stationFault) {
								// Manually triggered (or already raised) mid-attempt -
								// stop retrying and go straight to the fault path below.
								emit retriesExhausted;
							} else {
							present (empty) {
								// Magazine has no lids at all - retrying changes nothing without a refill, so fault immediately instead of burning 3 timeouts.
								System.out.printf("lid grip attempt %d: magazine empty, giving up immediately%n", attempt);
								emit retriesExhausted;
							} else {
								if (attempt >= 3) {
									System.out.printf("lid grip attempt %d timed out, giving up%n", attempt);
									emit retriesExhausted;
								} else {
									System.out.printf("lid grip attempt %d timed out, retrying%n", attempt);
									abort (armAtSource) {
										sustain armSource;
									}
								}
							}
							}
							}
							pause;
						}
					}
					boolean placeOk;
					present (placeSucceeded) {
						placeOk = true;
					} else {
						placeOk = false;
					}

					if (placeOk) {
						// 7. The vacuum is switched off (wait until the workpiece is released, e.g. via !WPgripped).
						await(!WPgripped);
						// 8. The arm swivels to the position retracted so that the cup can be picked up by other machine.
						abort (armAtSource) {
							sustain armSource;
						}
						twin.recordEvent("lid placed");
						twin.update(PlantTwin.State.IDLE);
					} else {
						if (!LidFaultState.isStationFaulted()) {
							LidFaultState.raiseStationFault();
						}
						System.out.printf("FAULT - lid placement failed after %d attempts, bottle abandoned%n", attempt);
						twin.update(PlantTwin.State.ERROR);
						twin.recordEvent("Lid placement aborted (fault)");
						// Safe state: arm retracted, vacuum already off (not
						// asserted since we left the grip block above).
						abort (armAtSource) {
							sustain armSource;
						}
						// Backup unit takes over automatically for future bottles; hold stationFault just long enough for escalation/lamp below to see it.
						System.out.printf("station faulted - switching to backup unit for future bottles%n");
						LidFaultState.enterBackupMode();
						// Let the empty-magazine visual actually be seen before auto-refilling - an instant
						// refill flips the magazine back to full within one repaint, so an "empty" fault would
						// show the FAULT lamp lit while the magazine graphic still looks completely normal.
						{
							long tVisible = System.currentTimeMillis();
							while (System.currentTimeMillis() - tVisible < 1200) { pause; }
						}
						// The backup unit comes with its own full magazine - refill so future bottles aren't starved by the same empty-magazine fault.
						System.out.printf("backup unit auto-refilling the lid magazine%n");
						{
							long tRefill = System.currentTimeMillis();
							while (System.currentTimeMillis() - tRefill < 150) {
								LoaderRefillBridge.setRefill(true);
								pause;
							}
						}
						LoaderRefillBridge.setRefill(false);
						{
							long tBackup = System.currentTimeMillis();
							while (System.currentTimeMillis() - tBackup < 250) { pause; }
						}
						LidFaultState.clearStationFault();
					}

					// Tell the Rotary Table this station is done (placed or faulted); widened hold since this crosses the socket to RotaryTablePlantCD.
					{
						long tAck = System.currentTimeMillis();
						while (System.currentTimeMillis() - tAck < 100) {
							RotaryLidBridge.setLidPlacedAck(true);
							RotaryLidBridge.setLidFaulted(!placeOk);
							pause;
						}
						RotaryLidBridge.setLidPlacedAck(false);
						RotaryLidBridge.setLidFaulted(false);
					}

					// await(request) isn't edge-triggered - wait for !request first so this doesn't refire on the same still-held request.
					await (!request);
				}
			}
			await (manual);
			System.out.printf("Manual: %d%n", 1);
			abort (auto) {
				while (true) {
					present (pusherExtendM) {
						emit pusherExtend;
					}
					present (vacOnM) {
						emit vacOn;
					}
					present (armSourceM) {
						emit armSource;
					}
					present (armDestM) {
						emit armDest;
					}
					pause;
				}
			}
			await (auto);
		}
	}
	||
	{
		// Bridges LidFaultState into stationFault/attemptTimedOut signals and latches the GUI's Clear Fault button.
		loop {
			present (clearLidFaultM) {
				LidFaultState.clearStationFault();
				// Operator has physically swapped the backup unit back to
				// primary - return to normal fault detection.
				LidFaultState.exitBackupMode();
			}
			if (LidFaultState.isStationFaulted()) {
				emit stationFault;
				emit lidFaultE;
			}
			// 3000ms - a normal grip completes in ~1.2-1.5s, so this still gives margin for jitter without dragging out a genuine mechanical-slip retry.
			if (LidFaultState.isAttemptTimedOut(3000)) {
				emit attemptTimedOut;
			}
			if (LidFaultState.isUsingBackup()) {
				emit lidBackupE;
			}
			pause;
		}
	}
	||
	{
		// Escalates a station fault to the Coordinator; await(!stationFault) at the end stops this re-firing every hold expiry while the fault persists.
		loop {
			await (stationFault);
			System.out.printf("lidFaultOut -> coordinator (holding)%n");
			abort (!request) {
				long tFault = System.currentTimeMillis();
				while (System.currentTimeMillis() - tFault < 200) {
					emit lidFaultOut;
					pause;
				}
			}
			await (!stationFault);
		}
	}
}