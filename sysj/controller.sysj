import digitaltwin.PlantTwin;
import digitaltwin.TwinClient;
import run.RotaryLidBridge;
import run.LidFaultState;

Controller(
		input signal pusherRetracted,pusherExtended,WPgripped,armAtSource,armAtDest,empty,request;
		output signal pusherExtend,vacOn,armSource,armDest;
		input Integer signal mode;
		input signal pusherExtendM,vacOnM,armSourceM,armDestM;
		input signal clearLidFaultM;								// GUI -> controller (operator clears an active fault)
		output signal lidFaultE;									// controller -> UI viz (fault indicator)
		output signal lidFaultOut;									// controller -> coordinator (station faulted)
		)
->{

	signal auto, manual;
	// Bridges LidFaultState.stationFaulted into a signal the placement
	// thread can abort on, and attemptTimedOut into a per-attempt-timeout
	// signal - mirrors CapperController's identical fault architecture
	// (see CLAUDE.md and the IP report).
	signal stationFault, attemptTimedOut;

	{
		int modeVal = 0;
		loop {
			present (mode) {
				modeVal = (Integer)#mode;
			}
			if (modeVal == 1) {
				emit manual;
			}
			else {
				emit auto;
			}
			pause;
		}
	}
	||
	{
		TwinClient twin = new TwinClient("lid-placer", "127.0.0.1", 9090);
		twin.update(PlantTwin.State.IDLE);
		System.out.printf("main loop entered%n");
		loop {
			abort (manual) {
				// Handles every bottle offered while in auto mode, not just the
				// first - originally this abort's body ran exactly one cycle
				// and then fell straight through to await(manual) below,
				// which never becomes true in a pure-auto run, silently
				// stalling the station after its first bottle. Nesting the
				// cycle in its own loop here lets it keep re-arming for a
				// fresh request without ever needing a manual-mode round trip.
				loop {
					System.out.printf("Auto: %d%n", 1);
					twin.update(PlantTwin.State.IDLE);
					// 1. The arm swivels to the position extended if a new workpiece is requested (request).
					await (request);
					System.out.printf("request received%n");
					// Fetch live product ID at Position 3 (Lid Placer) -- without
					// this, twin.recordEvent(...) below has no productId to attach
					// to, and this station's outcomes (success AND fault) never
					// reach the bottle's own ProductTwin history at all.
					String productId = twin.getProductIdAtPosition(2);
					if (productId == null || productId.isEmpty()) {
						productId = "UNKNOWN";
					}
					twin.update(PlantTwin.State.IN_PROGRESS);
					abort (armAtDest) {
						sustain armDest;
					}
					// 2. The pusher extends and pushes a workpiece out of the magazine.

					abort (pusherExtended) {
						sustain pusherExtend;
					}
					// 3. The pusher retracts back once it is fully extended.
					await (pusherRetracted);
					// 4. The arm swivels back to the position retracted
					abort (armAtSource) {
						sustain armSource;
					}

					// 5 & 6. Vacuum on, hold until gripped, then hold the grip while
					// the arm swivels to destination - retried up to 3 times,
					// since a lid can be knocked loose mid-grip rather than
					// simply not arriving on time (see the IP report). Driven by
					// abort(signal){ loop{...} } rather than a Java while() -
					// sjc's JavaPrettyPrinter crashes with "TerminateNode can
					// have only one child" when a present/else whose branches
					// both pause() sits directly inside a while() loop, even
					// with nothing else nearby (confirmed by bisecting a
					// minimal reproduction against this sjc build) - see the
					// identical workaround in capperController.sysj.
					int attempt = 0;
					signal placeSucceeded, retriesExhausted;
					abort (placeSucceeded || retriesExhausted) {
						loop {
							attempt = attempt + 1;
							System.out.printf("lid grip attempt %d/3%n", attempt);
							LidFaultState.beginAttempt();
							abort ((WPgripped && armAtDest) || stationFault || attemptTimedOut) {
								{sustain vacOn;}
								||
								{sustain armDest;}
							}
							LidFaultState.endAttempt();
							present (WPgripped && armAtDest) {
								emit placeSucceeded;
							} else {
							present (stationFault) {
								// Manually triggered (or already raised) mid-attempt -
								// stop retrying and go straight to the fault path below.
								emit retriesExhausted;
							} else {
								if (attempt >= 3) {
									System.out.printf("lid grip attempt %d timed out, giving up%n", attempt);
									emit retriesExhausted;
								} else {
									System.out.printf("lid grip attempt %d timed out, retrying%n", attempt);
									abort (armAtSource) {
										sustain armSource;
									}
								}
							}
							}
							pause;
						}
					}
					boolean placeOk;
					present (placeSucceeded) {
						placeOk = true;
					} else {
						placeOk = false;
					}

					if (placeOk) {
						// 7. The vacuum is switched off (wait until the workpiece is released, e.g. via !WPgripped).
						await(!WPgripped);
						// 8. The arm swivels to the position retracted so that the cup can be picked up by other machine.
						abort (armAtSource) {
							sustain armSource;
						}
						twin.recordEvent("lid placed", productId);
						twin.update(PlantTwin.State.IDLE);
					} else {
						if (!LidFaultState.isStationFaulted()) {
							LidFaultState.raiseStationFault();
						}
						System.out.printf("FAULT - lid placement failed after %d attempts, bottle abandoned%n", attempt);
						twin.update(PlantTwin.State.ERROR);
						twin.recordEvent("Lid placement aborted (fault)", productId);
						// Safe state: arm retracted, vacuum already off (not
						// asserted since we left the grip block above).
						abort (armAtSource) {
							sustain armSource;
						}
						System.out.printf("awaiting fault clear before returning to rotation%n");
						await (!stationFault);
						System.out.printf("fault cleared, resuming%n");
					}

					// Tell the Rotary Table this station is done with the bottle
					// (whether placed or faulted) so it can move on to the
					// Capper - same abandon-and-continue philosophy as the
					// Filler/Capper, see CLAUDE.md. Ack-or-timeout hold, not a
					// bare single-tick emit, since this crosses the socket to
					// RotaryTablePlantCD and repeats once per bottle - see
					// CLAUDE.md.
					{
						long tAck = System.currentTimeMillis();
						while (System.currentTimeMillis() - tAck < 200) {
							RotaryLidBridge.setLidPlacedAck(true);
							pause;
						}
						RotaryLidBridge.setLidPlacedAck(false);
					}

					// Don't re-arm on the same still-true request: the Rotary
					// Table holds "request" present until it has seen this
					// ack, so await(request) isn't edge-triggered and would
					// otherwise immediately refire on the very request that
					// just completed (the await-re-arming pitfall in
					// CLAUDE.md).
					await (!request);
				}
			}
			await (manual);
			System.out.printf("Manual: %d%n", 1);
			abort (auto) {
				while (true) {
					present (pusherExtendM) {
						emit pusherExtend;
					}
					present (vacOnM) {
						emit vacOn;
					}
					present (armSourceM) {
						emit armSource;
					}
					present (armDestM) {
						emit armDest;
					}
					pause;
				}
			}
			await (auto);
		}
	}
	||
	{
		// Bridges LidFaultState into stationFault/attemptTimedOut and
		// latches the GUI's Clear Fault button - mirrors CapperController's
		// identical bridging thread. No direct "trigger fault" signal here
		// (unlike an earlier version) - matching the Filler, the only way
		// to demonstrate a fault is to simulate the real physical cause
		// ("Drop Lid" on the Plant side, see plant.sysj) so this
		// controller's own retry/timeout detection is what actually raises
		// it, not the GUI faking the end state.
		loop {
			present (clearLidFaultM) {
				LidFaultState.clearStationFault();
			}
			if (LidFaultState.isStationFaulted()) {
				emit stationFault;
				emit lidFaultE;
			}
			if (LidFaultState.isAttemptTimedOut(8000)) {
				emit attemptTimedOut;
			}
			pause;
		}
	}
	||
	{
		// Escalates a station fault to the Coordinator. The await(!stationFault)
		// at the end matters: stationFault stays present for the whole fault,
		// and await isn't edge-triggered, so without it this would restart
		// every time the hold below expires for as long as the fault lasts -
		// see CLAUDE.md.
		loop {
			await (stationFault);
			System.out.printf("lidFaultOut -> coordinator (holding)%n");
			abort (!request) {
				long tFault = System.currentTimeMillis();
				while (System.currentTimeMillis() - tFault < 200) {
					emit lidFaultOut;
					pause;
				}
			}
			await (!stationFault);
		}
	}
}